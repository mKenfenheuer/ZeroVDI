@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="@(isError ? "alert-error" : "alert-success") mb-4" role="alert">
        <i class="@(isError ? "ri-error-warning-line text-destructive" : "ri-checkbox-circle-line text-success") text-lg"></i>
        <p class="text-sm flex-1">@Model</p>
    </div>
}
