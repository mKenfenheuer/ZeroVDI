@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<h2 class="text-xl font-semibold text-center mb-1">Sign in</h2>
<p class="text-sm text-muted-foreground text-center mb-6">Welcome back. Enter your details to continue.</p>

<form id="account" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-destructive" role="alert"></div>

    <div class="space-y-1.5">
        <label asp-for="Input.Email" class="block text-sm font-medium">Email</label>
        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com"
               class="w-full px-3 py-2 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition" />
        <span asp-validation-for="Input.Email" class="text-xs text-destructive"></span>
    </div>

    <div class="space-y-1.5">
        <label asp-for="Input.Password" class="block text-sm font-medium">Password</label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" aria-required="true" placeholder="••••••••"
               class="w-full px-3 py-2 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition" />
        <span asp-validation-for="Input.Password" class="text-xs text-destructive"></span>
    </div>

    <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm cursor-pointer">
            <input asp-for="Input.RememberMe" class="rounded border-border text-primary focus:ring-ring" />
            <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
        </label>
        <a id="forgot-password" asp-page="./ForgotPassword" class="text-sm text-primary hover:underline">Forgot password?</a>
    </div>

    <button id="login-submit" type="submit"
            class="w-full px-4 py-2.5 text-sm font-medium bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition-opacity">
        Sign in
    </button>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
