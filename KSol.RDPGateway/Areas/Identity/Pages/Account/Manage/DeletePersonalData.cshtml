@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete personal data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="text-lg font-semibold mb-1">Delete account</h2>
<div class="alert-error my-4 max-w-md">
    <i class="ri-error-warning-line text-destructive text-lg"></i>
    <p class="text-sm flex-1"><strong>Deleting this data permanently removes your account and cannot be undone.</strong></p>
</div>

<form id="delete-user" method="post" class="space-y-4 max-w-md">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    @if (Model.RequirePassword)
    {
        <div>
            <label asp-for="Input.Password" class="form-label">Confirm password</label>
            <input asp-for="Input.Password" type="password" class="form-input" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="form-error"></span>
        </div>
    }
    <button class="btn-destructive" type="submit">Delete data and close my account</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
