@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.Request.Query["mfaRequired"] == "1")
{
    <div class="alert-warning mb-4">
        <i class="ri-shield-keyhole-line text-lg"></i>
        <div class="text-sm">Multi-factor authentication is required for your account. Set up an authenticator app below to continue.</div>
    </div>
}
<h2 class="text-lg font-semibold mb-4">Configure authenticator app</h2>

<ol class="space-y-5 text-sm max-w-xl list-decimal list-inside marker:text-muted-foreground">
    <li>
        Download a two-factor authenticator app like Microsoft Authenticator
        (<a class="text-primary hover:underline" href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a>,
        <a class="text-primary hover:underline" href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>)
        or Google Authenticator
        (<a class="text-primary hover:underline" href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a>,
        <a class="text-primary hover:underline" href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>).
    </li>
    <li>
        Scan the QR code or enter this key into your app:
        <kbd class="inline-block px-2 py-1 rounded bg-muted font-mono text-xs my-2">@Model.SharedKey</kbd>
        <div class="alert-info my-2">
            <i class="ri-information-line text-info text-lg"></i>
            <div class="text-sm">Learn how to <a class="text-primary hover:underline" href="https://go.microsoft.com/fwlink/?Linkid=852423">enable QR code generation</a>.</div>
        </div>
        <div id="qrCode" class="my-2"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
    </li>
    <li>
        Enter the code your app shows to confirm:
        <form id="send-code" method="post" class="mt-3 space-y-3 max-w-xs">
            <div>
                <label asp-for="Input.Code" class="form-label">Verification code</label>
                <input asp-for="Input.Code" class="form-input tracking-widest" autocomplete="off" placeholder="000000" />
                <span asp-validation-for="Input.Code" class="form-error"></span>
            </div>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <button type="submit" class="btn-primary">Verify</button>
        </form>
    </li>
</ol>

@section Scripts { <partial name="_ValidationScripts" /> }
