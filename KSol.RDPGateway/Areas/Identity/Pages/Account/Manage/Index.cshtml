@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="text-lg font-semibold mb-1">Profile</h2>
<p class="text-sm text-muted-foreground mb-6">Your account details.</p>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" class="space-y-4 max-w-md">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div>
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-input opacity-60" placeholder="Username" disabled />
    </div>
    <div>
        <label asp-for="Input.PhoneNumber" class="form-label">Phone number</label>
        <input asp-for="Input.PhoneNumber" class="form-input" placeholder="Phone number" />
        <span asp-validation-for="Input.PhoneNumber" class="form-error"></span>
    </div>
    <button id="update-profile-button" type="submit" class="btn-primary">Save changes</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
