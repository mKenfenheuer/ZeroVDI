@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
<h2 class="text-xl font-semibold text-center mb-6">@ViewData["Title"]</h2>
<form method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <div>
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="form-error"></span>
    </div>
    <div>
        <label asp-for="Input.Password" class="form-label">New password</label>
        <input asp-for="Input.Password" type="password" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
        <span asp-validation-for="Input.Password" class="form-error"></span>
    </div>
    <div>
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" type="password" class="form-input" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
        <span asp-validation-for="Input.ConfirmPassword" class="form-error"></span>
    </div>
    <button type="submit" class="btn-primary w-full">Reset password</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
