      "KSol.RDPGateway": "Debug",
      "KSol.RDPGateway.SubscribeDiagnostics": "Information",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
