{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/app_db.sqlite;Cache=Shared"
  },
  "Recording": {
    "Directory": "Data/recordings",
    "DefaultEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
