@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable 2FA";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="text-lg font-semibold mb-4">Disable two-factor authentication</h2>
<div class="alert-warning mb-4 max-w-xl">
    <i class="ri-alert-line text-warning text-lg"></i>
    <div class="text-sm">
        <strong>This only disables 2FA.</strong> It does not change your authenticator keys. To change the key,
        <a class="text-primary hover:underline" asp-page="./ResetAuthenticator">reset your authenticator</a>.
    </div>
</div>
<form method="post">
    <button class="btn-destructive" type="submit">Disable 2FA</button>
</form>
