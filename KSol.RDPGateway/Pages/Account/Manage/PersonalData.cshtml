@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="text-lg font-semibold mb-1">Personal data</h2>
<p class="text-sm text-muted-foreground mb-6 max-w-md">Your account contains personal data you have given us. Download or delete that data here.</p>

<div class="flex flex-wrap items-center gap-3">
    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="btn-secondary" type="submit"><i class="ri-download-line"></i> Download</button>
    </form>
    <a id="delete" asp-page="DeletePersonalData" class="btn-destructive"><i class="ri-delete-bin-line"></i> Delete account</a>
</div>

@section Scripts { <partial name="_ValidationScripts" /> }
