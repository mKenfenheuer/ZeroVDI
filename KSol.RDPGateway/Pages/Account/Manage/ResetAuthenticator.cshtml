@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Reset authenticator key";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="text-lg font-semibold mb-4">Reset authenticator key</h2>
<div class="alert-warning mb-4 max-w-xl">
    <i class="ri-alert-line text-warning text-lg"></i>
    <div class="text-sm">
        <strong>Your authenticator app will stop working until you reconfigure it.</strong>
        This disables 2FA until you verify the app again — you may lose access if you don't complete setup.
    </div>
</div>
<form id="reset-authenticator-form" method="post">
    <button id="reset-authenticator-button" class="btn-destructive" type="submit">Reset authenticator key</button>
</form>
