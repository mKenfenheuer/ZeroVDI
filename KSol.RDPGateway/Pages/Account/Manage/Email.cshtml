@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h2 class="text-lg font-semibold mb-1">Email</h2>
<p class="text-sm text-muted-foreground mb-6">Manage the email address for your account.</p>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="space-y-4 max-w-md">
    <div asp-validation-summary="All" role="alert"></div>
    <div>
        <label asp-for="Email" class="form-label">Current email</label>
        <div class="relative">
            <input asp-for="Email" class="form-input opacity-60 @(Model.IsEmailConfirmed ? "pr-9" : "")" placeholder="Email" disabled />
            @if (Model.IsEmailConfirmed)
            {
                <i class="ri-checkbox-circle-fill text-success absolute right-3 top-1/2 -translate-y-1/2"></i>
            }
        </div>
        @if (!Model.IsEmailConfirmed)
        {
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="text-sm text-primary hover:underline mt-1">Send verification email</button>
        }
    </div>
    <div>
        <label asp-for="Input.NewEmail" class="form-label">New email</label>
        <input asp-for="Input.NewEmail" class="form-input" autocomplete="email" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.NewEmail" class="form-error"></span>
    </div>
    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-primary">Change email</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
