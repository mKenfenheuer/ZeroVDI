@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="text-lg font-semibold mb-4">Generate recovery codes</h2>
<div class="alert-warning mb-4 max-w-xl">
    <i class="ri-alert-line text-warning text-lg"></i>
    <div class="text-sm">
        <strong>Put these codes in a safe place.</strong> If you lose your device and your recovery codes you will lose access to your account.
        Generating new codes does not change your authenticator keys.
    </div>
</div>
<form method="post">
    <button class="btn-destructive" type="submit">Generate recovery codes</button>
</form>
