@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}
<div class="text-center">
    <div class="w-12 h-12 rounded-full bg-success/10 text-success flex items-center justify-center mx-auto mb-4">
        <i class="ri-mail-check-line text-2xl"></i>
    </div>
    <h2 class="text-xl font-semibold mb-1">@ViewData["Title"]</h2>
    <p class="text-sm text-muted-foreground mb-6">Please check your email to reset your password.</p>
    <a asp-page="./Login" class="btn-primary w-full">Back to sign in</a>
</div>
