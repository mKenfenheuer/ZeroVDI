@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}
<h2 class="text-xl font-semibold text-center mb-1">@ViewData["Title"]</h2>
<p class="text-sm text-muted-foreground text-center mb-6">Enter the code from your authenticator app.</p>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="space-y-4">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div>
        <label asp-for="Input.TwoFactorCode" class="form-label">Authenticator code</label>
        <input asp-for="Input.TwoFactorCode" class="form-input tracking-widest text-center" autocomplete="off" inputmode="numeric" />
        <span asp-validation-for="Input.TwoFactorCode" class="form-error"></span>
    </div>
    <label class="flex items-center gap-2 text-sm cursor-pointer">
        <input asp-for="Input.RememberMachine" class="form-check" />
        <span>@Html.DisplayNameFor(m => m.Input.RememberMachine)</span>
    </label>
    <button type="submit" class="btn-primary w-full">Sign in</button>
</form>
<p class="text-sm text-muted-foreground text-center mt-4">
    No access to your device?
    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary hover:underline">Use a recovery code</a>.
</p>

@section Scripts { <partial name="_ValidationScripts" /> }
