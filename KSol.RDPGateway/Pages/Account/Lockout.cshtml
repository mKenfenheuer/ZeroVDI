@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}
<div class="text-center">
    <div class="w-12 h-12 rounded-full bg-destructive/10 text-destructive flex items-center justify-center mx-auto mb-4">
        <i class="ri-lock-line text-2xl"></i>
    </div>
    <h2 class="text-xl font-semibold mb-1">@ViewData["Title"]</h2>
    <p class="text-sm text-muted-foreground">This account has been locked out. Please try again later.</p>
</div>
