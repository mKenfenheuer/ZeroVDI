@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}
<h2 class="text-xl font-semibold text-center mb-1">@ViewData["Title"]</h2>
<p class="text-sm text-muted-foreground text-center mb-6">
    Logging in with a recovery code won't be remembered until you sign in with an authenticator code or disable 2FA.
</p>
<form method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div>
        <label asp-for="Input.RecoveryCode" class="form-label">Recovery code</label>
        <input asp-for="Input.RecoveryCode" class="form-input" autocomplete="off" placeholder="xxxxx-xxxxx" />
        <span asp-validation-for="Input.RecoveryCode" class="form-error"></span>
    </div>
    <button type="submit" class="btn-primary w-full">Sign in</button>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
