@model KSol.RDPGateway.Models.RecordingRule
@{
    ViewData["Title"] = "Edit recording rule";
}

@section PageActions {
    <a asp-action="Index" class="btn-secondary w-fit"><i class="ri-arrow-left-line"></i> Back to list</a>
}

<form asp-action="Edit" class="card-surface p-6 max-w-3xl">
    <input type="hidden" asp-for="Id" />
    <partial name="_Fields" model="Model" />
    <div class="flex items-center gap-2 mt-6 pt-4 border-t border-border">
        <button type="submit" class="btn-primary">Save changes</button>
        <a asp-action="Index" class="btn-ghost">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
