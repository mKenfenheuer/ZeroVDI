@model IEnumerable<KSol.RDPGateway.Models.RecordingRule>
@{
    ViewData["Title"] = "Recording rules";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Recording rules</h1>
        <p class="text-muted mb-0">Evaluated top-to-bottom; the first matching rule decides whether a session is recorded. No match → the global default (Recording:DefaultEnabled).</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Add rule</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Scope</th>
                    <th>Target</th>
                    <th>Action</th>
                    <th>Enabled</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No rules — sessions follow the global default.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Order</td>
                    <td>@r.Scope</td>
                    <td>
                        @switch (r.Scope)
                        {
                            case KSol.RDPGateway.Models.RecordingRuleScope.User: @r.UserId break;
                            case KSol.RDPGateway.Models.RecordingRuleScope.Resource: @r.RDPResourceId break;
                            case KSol.RDPGateway.Models.RecordingRuleScope.Role: @r.RoleName break;
                            default: <span class="text-muted">(all)</span> break;
                        }
                    </td>
                    <td>
                        @if (r.Action == KSol.RDPGateway.Models.RecordingRuleAction.Allow)
                        {
                            <span class="badge bg-success">Record</span>
                            @if (r.NotifyUser) { <span class="badge bg-info text-dark ms-1" title="User is notified the session is recorded">Notify</span> }
                        }
                        else { <span class="badge bg-secondary">Don't record</span> }
                    </td>
                    <td>@(r.Enabled ? "Yes" : "No")</td>
                    <td class="text-muted">@r.Description</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
