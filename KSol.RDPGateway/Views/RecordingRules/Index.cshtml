@model IEnumerable<KSol.RDPGateway.Models.RecordingRule>
@{
    ViewData["Title"] = "Recording rules";
    ViewData["Subtitle"] = "Evaluated top-to-bottom; first match decides. No match → the global default.";
}

@section PageActions {
    <a asp-action="Create" class="btn-primary w-fit"><i class="ri-add-line"></i> Add rule</a>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-record-circle-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No rules</h3>
        <p class="text-sm text-muted-foreground mt-1">Sessions follow the global default until you add a rule.</p>
        <a asp-action="Create" class="btn-primary mt-4"><i class="ri-add-line"></i> Add rule</a>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Order</th>
                <th>Scope</th>
                <th>Target</th>
                <th>Action</th>
                <th>Enabled</th>
                <th>Description</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Order</td>
                <td>@r.Scope</td>
                <td>
                    @switch (r.Scope)
                    {
                        case KSol.RDPGateway.Models.RecordingRuleScope.User: @r.UserId break;
                        case KSol.RDPGateway.Models.RecordingRuleScope.Resource: @r.RDPResourceId break;
                        case KSol.RDPGateway.Models.RecordingRuleScope.Role: @r.RoleName break;
                        default: <span class="text-muted-foreground">(all)</span> break;
                    }
                </td>
                <td>
                    @if (r.Action == KSol.RDPGateway.Models.RecordingRuleAction.Allow)
                    {
                        <span class="badge bg-success/10 text-success">Record</span>
                        @if (r.NotifyUser) { <span class="badge bg-info/10 text-info ml-1" title="User is notified the session is recorded">Notify</span> }
                    }
                    else { <span class="badge-muted">Don't record</span> }
                </td>
                <td>@(r.Enabled ? "Yes" : "No")</td>
                <td class="text-muted-foreground">@r.Description</td>
                <td>
                    <div class="flex items-center justify-end gap-2">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn-secondary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
