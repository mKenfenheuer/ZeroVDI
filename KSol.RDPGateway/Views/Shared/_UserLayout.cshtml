@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "px-4 py-2 text-sm font-medium text-foreground bg-muted rounded-lg transition-colors"
            : "px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — KSol.IT RDP Gateway</title>
    <partial name="_ThemeHead" />
</head>
<body class="bg-background text-foreground min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 h-16 bg-card border-b border-border flex items-center px-4 sm:px-6">
        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 mr-4">
            <i class="ri-remote-control-line text-2xl text-primary"></i>
            <span class="font-semibold text-lg hidden sm:inline">RDP Gateway</span>
        </a>
        <partial name="_NavActions" />
    </header>

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
        @RenderBody()
    </main>
    
    <partial name="_Toasts" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
