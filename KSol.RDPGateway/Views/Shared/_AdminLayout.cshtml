@{
    // The top-bar help icon (in _NavActions) follows the current dashboard: "admin" → /admin/docs.
    ViewData["DocsArea"] = "admin";
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    // Admin sidebar: only the three approved top-level items.
    // NOTE: controllers are still area-less (RDPResources/ProxmoxBackends/Users); they move into the
    // Admin area in a later stage, at which point these links gain asp-area="Admin".
    var navItems = new (string Controller, string Label, string Icon)[]
    {
        ("RDPResources", "Resources", "ri-computer-line"),
        ("VdiPools", "VDI Pools", "ri-stack-line"),
        ("ProxmoxBackends", "Backends", "ri-server-line"),
        ("Connectors", "Connectors", "ri-plug-line"),
        ("Users", "Users", "ri-team-line"),
        ("UserGroups", "Groups", "ri-group-line"),
    };
    string ItemClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium bg-sidebar-accent text-sidebar-accent-foreground"
            : "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground transition-colors";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — Admin — ZeroVDI</title>
    <partial name="_ThemeHead" />
    <style>
        /* Documentation contents tree (collapsible, in the sidebar under the Documentation link). */
        .doc-nav-list { list-style: none; margin: 0; padding: 0; }
        .doc-nav-children { padding-left: 0.5rem; border-left: 1px solid var(--sidebar-border); margin-left: 0.6rem; }
        .doc-nav-link, .doc-nav-header { display: flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.55rem; border-radius: 0.45rem; font-size: 0.82rem; color: color-mix(in oklch, var(--sidebar-foreground) 72%, transparent); text-decoration: none; }
        .doc-nav-link:hover { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
        .doc-nav-header { color: color-mix(in oklch, var(--sidebar-foreground) 48%, transparent); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.25rem; }
        .doc-nav-active { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); font-weight: 500; }
        details > summary::-webkit-details-marker { display: none; }
    </style>
</head>
<body class="bg-background text-foreground min-h-screen">
    <!-- Top bar -->
    <header class="fixed top-0 left-0 right-0 h-16 bg-card border-b border-border z-50 flex items-center">
        <div class="w-[260px] h-full items-center px-5 border-r border-border flex-shrink-0 hidden lg:flex">
            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2">
                <partial name="_Logo" />
            </a>
        </div>
        <div class="flex items-center px-4 lg:hidden">
            <button id="mobile-menu-toggle" type="button" aria-label="Menu"
                    class="w-10 h-10 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors mr-2">
                <i class="ri-menu-line text-xl"></i>
            </button>
            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2">
                <partial name="_Logo" />
                <span class="font-semibold text-lg text-foreground">ZeroVDI</span>
            </a>
        </div>
        <div class="flex-1 h-full flex items-center px-4 lg:px-5">
            <span class="hidden lg:inline text-sm text-muted-foreground">Administration</span>
            <partial name="_NavActions" />
        </div>
    </header>

    <!-- Mobile sidebar overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden opacity-0 transition-opacity duration-300 lg:hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="fixed top-16 left-0 w-[260px] h-[calc(100vh-4rem)] bg-sidebar text-sidebar-foreground border-r border-sidebar-border z-40 transition-transform duration-300 lg:translate-x-0 -translate-x-full overflow-y-auto">
        <nav class="p-4 flex flex-col gap-1">
            <a asp-controller="Admin" asp-action="Index" class="@ItemClass("Admin")">
                <i class="ri-dashboard-line text-lg"></i><span>Dashboard</span>
            </a>
            <p class="px-3 py-2 mt-3 text-xs font-medium text-sidebar-foreground/50 uppercase tracking-wide">Management</p>
            @foreach (var item in navItems)
            {
                <a asp-controller="@item.Controller" asp-action="Index" class="@ItemClass(item.Controller)">
                    <i class="@item.Icon text-lg"></i><span>@item.Label</span>
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-area="" asp-controller="DevicePolicy" asp-action="Index" class="@ItemClass("DevicePolicy")">
                    <i class="ri-shield-keyhole-line text-lg"></i><span>Device policy</span>
                </a>
                <a asp-area="" asp-controller="Appearance" asp-action="Index" class="@ItemClass("Appearance")">
                    <i class="ri-palette-line text-lg"></i><span>Appearance</span>
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("Auditor"))
            {
                <p class="px-3 py-2 mt-3 text-xs font-medium text-sidebar-foreground/50 uppercase tracking-wide">Audit</p>
                <a asp-area="" asp-controller="Sessions" asp-action="Index" class="@ItemClass("Sessions")">
                    <i class="ri-pulse-line text-lg"></i><span>Active sessions</span>
                </a>
                <a asp-area="" asp-controller="Audit" asp-action="Index" class="@ItemClass("Audit")">
                    <i class="ri-history-line text-lg"></i><span>Audit log</span>
                </a>
                <a asp-area="" asp-controller="Recordings" asp-action="Index" class="@ItemClass("Recordings")">
                    <i class="ri-film-line text-lg"></i><span>Recordings</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="" asp-controller="RecordingRules" asp-action="Index" class="@ItemClass("RecordingRules")">
                        <i class="ri-record-circle-line text-lg"></i><span>Recording rules</span>
                    </a>
                }
            }

            @{
                var onDocs = string.Equals(currentController, "Docs", StringComparison.OrdinalIgnoreCase);
                var docsCurrentUrl = onDocs ? (ViewContext.RouteData.Values["path"] as string ?? "") : "";
            }
            <p class="px-3 py-2 mt-3 text-xs font-medium text-sidebar-foreground/50 uppercase tracking-wide">Help</p>
            <details class="group/docs" @(onDocs ? "open" : null)>
                <summary class="@ItemClass("Docs") cursor-pointer list-none">
                    <i class="ri-book-open-line text-lg"></i>
                    <a href="/admin/docs" class="flex-1">Documentation</a>
                    <i class="ri-arrow-right-s-line text-base transition-transform group-open/docs:rotate-90"></i>
                </summary>
                <div class="mt-1 ml-2 pl-2 border-l border-sidebar-border">
                    @await Component.InvokeAsync("DocsNav", new { currentUrl = docsCurrentUrl })
                </div>
            </details>

            <div class="mt-auto pt-4 border-t border-sidebar-border mt-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="@ItemClass("__none__")">
                    <i class="ri-arrow-left-line text-lg"></i><span>Back to app</span>
                </a>
            </div>
        </nav>
    </aside>

    <!-- Content -->
    <main class="lg:ml-[260px] pt-16 min-h-screen">
        @if (ViewData["Title"] is string title && !string.IsNullOrEmpty(title))
        {
            <div class="bg-card border-b border-border px-4 sm:px-6 py-4 sm:py-5">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <h1 class="text-lg sm:text-xl font-semibold">@title</h1>
                        @if (ViewData["Subtitle"] is string subtitle)
                        {
                            <p class="text-sm text-muted-foreground mt-0.5">@subtitle</p>
                        }
                    </div>
                    @await RenderSectionAsync("PageActions", required: false)
                </div>
            </div>
        }
        <div class="p-4 sm:p-6">
            @RenderBody()
        </div>
    </main>

    <partial name="_Toasts" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
