@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — KSol.IT RDP Gateway</title>
    <partial name="_ThemeHead" />
</head>
<body class="bg-background text-foreground min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <div class="flex flex-col items-center mb-6">
            <i class="ri-remote-control-line text-4xl text-primary mb-2"></i>
            <h1 class="text-xl font-semibold">KSol.IT RDP Gateway</h1>
        </div>
        <div class="bg-card text-card-foreground border border-border rounded-2xl shadow-sm p-6 sm:p-8">
            @RenderBody()
        </div>
        <p class="text-center text-xs text-muted-foreground mt-6">&copy; @DateTime.UtcNow.Year KSol.IT</p>
    </div>

    <partial name="_Toasts" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
