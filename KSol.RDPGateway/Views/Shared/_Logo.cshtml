@inject KSol.RDPGateway.RDP.AppearanceService Appearance
@{
    // Brand logo. By default this is the ZeroVDI "0VDI" wordmark, inlined via a CSS mask so it picks
    // up the active theme primary color. When an admin uploads a custom company logo
    // (AppearanceSettings.LogoPath) it is shown verbatim as an <img> instead.
    // Size via the optional model (a height utility), e.g. await Html.PartialAsync("_Logo", "h-9").
    var sizeClass = (Model as string) ?? "h-6";
    var appearance = Appearance.Get();
}
@if (appearance.HasCustomLogo)
{
    if (appearance.HasCustomLogoDark)
    {
        // Distinct logos per mode: render both, toggle on the <html> `.dark` class (no reload needed).
        <img src="@appearance.LogoPath" alt="Logo" class="@sizeClass w-auto object-contain block dark:hidden" />
        <img src="@appearance.LogoPathDark" alt="Logo" class="@sizeClass w-auto object-contain hidden dark:block" />
    }
    else
    {
        <img src="@appearance.LogoPath" alt="Logo" class="@sizeClass w-auto object-contain" />
    }
}
else
{
    <div class="logo"></div>
    <style>
        .logo {
            width: 60px;
            height: 22px;
            background: var(--primary);

            -webkit-mask: url("/img/zerovdi-logo.svg") no-repeat center;
            mask: url("/img/zerovdi-logo.svg") no-repeat center;
            -webkit-mask-size: contain;
            mask-size: contain;
        }
    </style>
}
