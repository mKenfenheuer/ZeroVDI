@model KSol.RDPGateway.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete user";
    var userRoles = (IEnumerable<string>)ViewBag.UserRoles ?? new List<string>();
}

<div class="card-surface p-6 max-w-2xl">
    <div class="w-12 h-12 rounded-full bg-destructive/10 text-destructive flex items-center justify-center mb-4">
        <i class="ri-user-unfollow-line text-2xl"></i>
    </div>
    <h1 class="text-xl font-semibold">Delete “@Model.UserName”?</h1>
    <p class="text-muted-foreground mt-1">This action cannot be undone.</p>

    <dl class="space-y-3 text-sm my-6">
        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Email</dt><dd>@Model.Email</dd></div>
        <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Roles</dt>
            <dd class="flex flex-wrap gap-1 justify-end">
                @if (userRoles.Any())
                {
                    foreach (var role in userRoles)
                    {
                        <span class="badge-primary">@role</span>
                    }
                }
                else
                {
                    <span class="text-muted-foreground">None</span>
                }
            </dd>
        </div>
    </dl>

    <form asp-action="Delete" method="post" class="flex items-center gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-destructive">Delete permanently</button>
        <a asp-action="Index" class="btn-ghost">Cancel</a>
    </form>
</div>
