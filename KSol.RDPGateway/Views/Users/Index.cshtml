@model IEnumerable<KSol.RDPGateway.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "Accounts that can sign in to the gateway.";
}

@section PageActions {
    <a asp-action="Create" class="btn-primary w-fit"><i class="ri-user-add-line"></i> Add user</a>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-team-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No users found</h3>
        <a asp-action="Create" class="btn-primary mt-4"><i class="ri-user-add-line"></i> Add user</a>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Status</th>
                <th>MFA</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="font-medium">@item.UserName</td>
                <td class="text-muted-foreground">@item.Email</td>
                <td>
                    @if (item.EmailConfirmed)
                    {
                        <span class="badge bg-success/10 text-success">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning/10 text-warning">Not confirmed</span>
                    }
                </td>
                <td>
                    @if (item.TwoFactorEnabled)
                    {
                        <span class="badge bg-success/10 text-success"><i class="ri-shield-check-line"></i> Enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-muted text-muted-foreground">Off</span>
                    }
                </td>
                <td>
                    <div class="flex items-center justify-end gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-ghost btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary btn-sm">Edit</a>
                        <a asp-action="AssignRoles" asp-route-id="@item.Id" class="btn-secondary btn-sm">Roles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
