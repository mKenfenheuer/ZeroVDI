@model KSol.RDPGateway.Models.ApplicationUser

@{
    ViewData["Title"] = "Assign roles";
    ViewData["Subtitle"] = $"{Model.UserName} ({Model.Email})";
    var allRoles = (IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.AllRoles ?? new List<Microsoft.AspNetCore.Identity.IdentityRole>();
    var userRoles = (IEnumerable<string>)ViewBag.UserRoles ?? new List<string>();
}

@section PageActions {
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary w-fit"><i class="ri-arrow-left-line"></i> Back</a>
}

<form asp-action="AssignRoles" method="post" class="card-surface p-6 max-w-xl space-y-5">
    <input type="hidden" name="id" value="@Model.Id" />
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">Roles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            @foreach (var role in allRoles)
            {
                <label class="flex items-center gap-2 text-sm cursor-pointer p-2 rounded-lg hover:bg-muted">
                    <input class="form-check" type="checkbox" name="selectedRoles" value="@role.Name"
                           id="role_@role.Id" @(userRoles.Contains(role.Name) ? "checked" : "") />
                    <span>@role.Name</span>
                </label>
            }
        </div>
    </div>

    <div class="flex items-center gap-2 pt-2 border-t border-border">
        <button type="submit" class="btn-primary">Save roles</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ghost">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScripts" /> }
