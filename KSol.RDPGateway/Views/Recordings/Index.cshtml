@model IEnumerable<KSol.RDPGateway.Models.Recording>
@using KSol.RDPGateway.Models
@{
    ViewData["Title"] = "Recordings";
    ViewData["Subtitle"] = "Recorded console sessions — replay the desktop and camera streams.";
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-film-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No recordings yet</h3>
        <p class="text-sm text-muted-foreground mt-1">Sessions matching a recording rule will appear here.</p>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Started (UTC)</th>
                <th>User</th>
                <th>Resource</th>
                <th>Duration</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.StartedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@(r.User?.UserName ?? r.UserId)</td>
                <td>@(r.RDPResource?.Name ?? r.RDPResourceId)</td>
                <td>@(r.EndedUtc is { } e ? (e - r.StartedUtc).ToString(@"hh\:mm\:ss") : "—")</td>
                <td>
                    @switch (r.Status)
                    {
                        case RecordingStatus.Recording: <span class="badge bg-info/10 text-info">Recording</span> break;
                        case RecordingStatus.Processing: <span class="badge bg-info/10 text-info">Processing…</span> break;
                        case RecordingStatus.Completed: <span class="badge bg-success/10 text-success">Completed</span> break;
                        case RecordingStatus.UnsupportedCodec: <span class="badge bg-warning/10 text-warning" title="Desktop video codec wasn't H.264; audio only">Audio only</span> break;
                        default: <span class="badge bg-destructive/10 text-destructive">Failed</span> break;
                    }
                </td>
                <td>
                    @{ var playable = r.Status is RecordingStatus.Completed or RecordingStatus.UnsupportedCodec
                           && (r.DesktopFilePath != null || r.CameraFilePath != null
                               || r.AudioFilePath != null || r.MicFilePath != null);
                       var deletable = r.Status is not (RecordingStatus.Recording or RecordingStatus.Processing); }
                    <div class="flex items-center justify-end gap-2">
                        @if (playable)
                        {
                            <a asp-action="Play" asp-route-id="@r.Id" class="btn-secondary btn-sm"><i class="ri-play-line"></i> Replay</a>
                        }
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="inline"
                                onsubmit="return confirm('Delete this recording and its files? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
