@model KSol.RDPGateway.Models.RdpOptions
@{
    // Rendered inside a parent form whose model exposes RdpOptions; the name prefix is set by the
    // caller so the inputs post back as RdpOptions.<field>.
}
<details class="card-surface group">
    <summary class="flex items-center justify-between cursor-pointer select-none px-4 py-3 text-sm font-medium">
        <span class="flex items-center gap-2"><i class="ri-settings-3-line"></i> RDP options</span>
        <i class="ri-arrow-down-s-line transition-transform group-open:rotate-180"></i>
    </summary>
    <div class="px-4 pb-4 pt-1 border-t border-border space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label asp-for="ScreenModeId" class="form-label">Screen mode</label>
                <select asp-for="ScreenModeId" class="form-select">
                    <option value="1">Windowed</option>
                    <option value="2">Full screen</option>
                </select>
            </div>
            <div>
                <label asp-for="DesktopWidth" class="form-label">Width</label>
                <input asp-for="DesktopWidth" class="form-input" type="number" />
            </div>
            <div>
                <label asp-for="DesktopHeight" class="form-label">Height</label>
                <input asp-for="DesktopHeight" class="form-input" type="number" />
            </div>
            <div>
                <label asp-for="SessionBpp" class="form-label">Colour depth (bpp)</label>
                <select asp-for="SessionBpp" class="form-select">
                    <option value="15">15</option>
                    <option value="16">16</option>
                    <option value="24">24</option>
                    <option value="32">32</option>
                </select>
            </div>
            <div>
                <label asp-for="AudioMode" class="form-label">Audio</label>
                <select asp-for="AudioMode" class="form-select">
                    <option value="0">Play on this computer</option>
                    <option value="1">Play on remote</option>
                    <option value="2">Do not play</option>
                </select>
            </div>
            <div>
                <label asp-for="DriveStoreRedirect" class="form-label">Redirect drives</label>
                <input asp-for="DriveStoreRedirect" class="form-input" placeholder="* for all, blank for none" />
            </div>
            <div>
                <label asp-for="CameraStoreRedirect" class="form-label">Redirect cameras</label>
                <input asp-for="CameraStoreRedirect" class="form-input" placeholder="* for all, blank for none" />
            </div>
        </div>

        <div>
            <h3 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2">Redirections</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="UseMultimon" class="form-check" /> <span>Use all monitors</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectClipboard" class="form-check" /> <span>Clipboard</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectPrinters" class="form-check" /> <span>Printers</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectSmartCards" class="form-check" /> <span>Smart cards</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectWebAuthn" class="form-check" /> <span>WebAuthn</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectComPorts" class="form-check" /> <span>COM ports</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectPosDevices" class="form-check" /> <span>POS devices</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="RedirectLocation" class="form-check" /> <span>Location</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="AudioCaptureMode" class="form-check" /> <span>Microphone</span></label>
            </div>
        </div>

        <div>
            <h3 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2">Experience</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="NetworkAutodetect" class="form-check" /> <span>Network autodetect</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="BandwidthAutodetect" class="form-check" /> <span>Bandwidth autodetect</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="Compression" class="form-check" /> <span>Compression</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="AutoReconnectionEnabled" class="form-check" /> <span>Auto-reconnect</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="DisableWallpaper" class="form-check" /> <span>Disable wallpaper</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="DisableThemes" class="form-check" /> <span>Disable themes</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="DisableMenuAnims" class="form-check" /> <span>Disable menu anims</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="DisableFullWindowDrag" class="form-check" /> <span>Disable full window drag</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="AllowFontSmoothing" class="form-check" /> <span>Font smoothing</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer"><input asp-for="AllowDesktopComposition" class="form-check" /> <span>Desktop composition</span></label>
            </div>
        </div>
    </div>
</details>
