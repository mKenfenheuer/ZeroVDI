@model KSol.RDPGateway.Models.RDPResource
@using KSol.RDPGateway.Models

@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = "Resource details";
    var isProxmox = Model.Source == ResourceSource.Proxmox;
}

@section PageActions {
    <div class="flex items-center gap-2">
        <span class="@(isProxmox ? "badge-primary" : "badge-muted")">@Model.Source</span>
        <partial name="_PowerStateBadge" model="Model.PowerState" />
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary">Edit</a>
        <a asp-action="Index" class="btn-ghost">Back</a>
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
    <div class="card-surface p-6">
        <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-4">General</h2>
        <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Identifier</dt><dd><code class="text-xs">@Model.Id</code></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Description</dt><dd class="text-right">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Last activity</dt><dd>@(Model.LastActivityUtc?.ToString("u") ?? "—")</dd></div>
        </dl>
    </div>
    <div class="card-surface p-6">
        <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-4">Connection</h2>
        <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Address</dt><dd>@(string.IsNullOrEmpty(Model.IpAddress) ? "—" : $"{Model.IpAddress}:{Model.Port}")</dd></div>
            @if (isProxmox)
            {
                <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Node</dt><dd>@(Model.ProxmoxNode ?? "—")</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-muted-foreground">VMID</dt><dd>@(Model.ProxmoxVmId?.ToString() ?? "—")</dd></div>
            }
        </dl>
    </div>
</div>

@if (isProxmox && !string.IsNullOrEmpty(Model.ConfigJson))
{
    <div class="card-surface p-6 mt-4 max-w-4xl">
        <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">VM notes (config)</h2>
        <pre class="text-xs bg-muted rounded-lg p-3 overflow-x-auto">@Model.ConfigJson</pre>
    </div>
}
