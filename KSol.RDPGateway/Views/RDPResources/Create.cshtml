@model KSol.RDPGateway.Models.RDPResource

@{
    ViewData["Title"] = "New resource";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New resource</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to list</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <h2 class="h6 text-uppercase text-muted mb-3">General</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Connection</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="IpAddress" class="form-label">IP address / host</label>
                    <input asp-for="IpAddress" class="form-control" placeholder="10.0.0.10" />
                    <span asp-validation-for="IpAddress" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Port" class="form-label">RDP port</label>
                    <input asp-for="Port" class="form-control" type="number" />
                    <span asp-validation-for="Port" class="text-danger"></span>
                </div>
            </div>

            <partial name="_RdpOptionsEditor" for="RdpOptions" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create resource</button>
                <a asp-action="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
