@model IEnumerable<KSol.RDPGateway.Models.ProxmoxBackend>

@{
    ViewData["Title"] = "Backends";
    ViewData["Subtitle"] = "Proxmox VE clusters that back your VDI resources.";
}

@section PageActions {
    <a asp-action="Create" class="btn-primary w-fit"><i class="ri-add-line"></i> Add backend</a>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-server-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No backends configured</h3>
        <p class="text-sm text-muted-foreground mt-1">Add a Proxmox backend to discover and manage VMs as resources.</p>
        <a asp-action="Create" class="btn-primary mt-4"><i class="ri-add-line"></i> Add backend</a>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Name</th>
                <th>Host</th>
                <th>Status</th>
                <th>Idle policy</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td class="font-medium">@b.Name</td>
                <td class="text-muted-foreground">@(b.Host ?? "—")</td>
                <td>
                    @if (b.IsConfigured)
                    {
                        <span class="badge bg-success/10 text-success">Configured</span>
                    }
                    else
                    {
                        <span class="badge bg-warning/10 text-warning">Incomplete</span>
                    }
                </td>
                <td class="text-muted-foreground text-xs">@b.IdleTimeoutHours h → @b.PauseAction</td>
                <td>
                    <div class="flex items-center justify-end gap-2">
                        <form asp-action="Discover" asp-route-id="@b.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-outline btn-sm text-success border-success/40 hover:bg-success/10">Discover</button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn-secondary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@b.Id" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Delete</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
