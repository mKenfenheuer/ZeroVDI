@model KSol.RDPGateway.Models.ProxmoxBackend

@{
    ViewData["Title"] = "Delete backend";
}

<div class="card-surface p-6 max-w-2xl">
    <div class="w-12 h-12 rounded-full bg-destructive/10 text-destructive flex items-center justify-center mb-4">
        <i class="ri-delete-bin-line text-2xl"></i>
    </div>
    <h1 class="text-xl font-semibold">Delete “@Model.Name”?</h1>
    <div class="alert-warning my-4">
        <i class="ri-alert-line text-warning text-lg"></i>
        <p class="text-sm flex-1">Resources discovered from this backend will no longer start or pause automatically. The VMs and their <code>ksol-rdpgw-id</code> notes are not changed.</p>
    </div>
    <dl class="space-y-2 text-sm my-4">
        <div class="flex gap-4"><dt class="text-muted-foreground w-24">Host</dt><dd>@(Model.Host ?? "—")</dd></div>
    </dl>
    <form asp-action="Delete" class="flex items-center gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-destructive">Delete backend</button>
        <a asp-action="Index" class="btn-ghost">Cancel</a>
    </form>
</div>
