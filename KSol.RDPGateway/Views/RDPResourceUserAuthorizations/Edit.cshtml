@model KSol.RDPGateway.Models.RDPResourceUserAuthorization

@{
    ViewData["Title"] = "Edit authorization";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit authorization</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to list</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label">User</label>
                    <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="RDPResourceId" class="form-label">Resource</label>
                    <select asp-for="RDPResourceId" class="form-select" asp-items="ViewBag.RDPResourceId"></select>
                    <span asp-validation-for="RDPResourceId" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
