@model KSol.RDPGateway.Models.RDPResourceUserAuthorization

@{
    ViewData["Title"] = "Edit authorization";
    ViewData["Subtitle"] = $"{Model.User?.UserName} → {Model.RDPResource?.Name ?? Model.RDPResourceId}";
}

@section PageActions {
    <a asp-action="Index" class="btn-secondary w-fit"><i class="ri-arrow-left-line"></i> Back to list</a>
}

@if (TempData["CredStatus"] is string credStatus)
{
    <div class="alert-success mb-4 max-w-3xl"><i class="ri-checkbox-circle-line text-success text-lg"></i><p class="text-sm flex-1">@credStatus</p></div>
}
@if (TempData["CredError"] is string credError)
{
    <div class="alert-error mb-4 max-w-3xl"><i class="ri-error-warning-line text-destructive text-lg"></i><p class="text-sm flex-1">@credError</p></div>
}

<div class="max-w-3xl space-y-4">
    <form asp-action="Edit" class="card-surface p-6 space-y-6">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Id" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="UserId" class="form-label">User</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="form-error"></span>
            </div>
            <div>
                <label asp-for="RDPResourceId" class="form-label">Resource</label>
                <select asp-for="RDPResourceId" class="form-select" asp-items="ViewBag.RDPResourceId"></select>
                <span asp-validation-for="RDPResourceId" class="form-error"></span>
            </div>
        </div>

        <div class="pt-2 border-t border-border">
            <h2 class="font-medium">Connection defaults</h2>
            <p class="text-sm text-muted-foreground mb-3">When set together with stored credentials, the in-browser console auto-connects without showing the login form.</p>
            @{ await Html.RenderPartialAsync("_ConnectionDefaultsEditor", Model.ConnectionDefaults ?? new KSol.RDPGateway.Models.ConnectionDefaults()); }
        </div>

        <div class="flex items-center gap-2 pt-2 border-t border-border">
            <button type="submit" class="btn-primary">Save changes</button>
            <a asp-action="Index" class="btn-ghost">Cancel</a>
        </div>
    </form>

    <div class="card-surface p-6">
        <h2 class="font-medium mb-1">Stored VM credentials (single sign-on)</h2>
        @if (Model.HasStoredCredentials)
        {
            <p class="text-sm mb-3"><span class="badge bg-success/10 text-success"><i class="ri-key-2-line"></i> Stored</span> — the console auto-connects for this user.</p>
            <form asp-action="ClearCredentials" asp-route-id="@Model.Id" method="post" class="mb-4">
                <button type="submit" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Clear stored credentials</button>
            </form>
            <p class="text-sm text-muted-foreground mb-2">Replace the stored credentials:</p>
        }
        else
        {
            <p class="text-sm mb-3"><span class="badge-muted">No credentials stored</span> — the user enters them at connect time.</p>
        }
        <form asp-action="SetCredentials" asp-route-id="@Model.Id" method="post" class="space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="form-label" for="cred-user">Username</label>
                    <input class="form-input" id="cred-user" name="username" autocomplete="off" />
                </div>
                <div>
                    <label class="form-label" for="cred-pass">Password</label>
                    <input class="form-input" id="cred-pass" name="password" type="password" autocomplete="new-password" />
                </div>
                <div>
                    <label class="form-label" for="cred-domain">Domain (optional)</label>
                    <input class="form-input" id="cred-domain" name="domain" autocomplete="off" />
                </div>
            </div>
            <p class="form-hint">Stored encrypted at rest; the password is never shown again after saving.</p>
            <button type="submit" class="btn-primary btn-sm">Store credentials</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScripts" /> }
