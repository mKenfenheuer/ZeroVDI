@model KSol.RDPGateway.Models.RDPResourceUserAuthorization

@{
    ViewData["Title"] = "Authorization details";
}

@section PageActions {
    <div class="flex items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary">Edit</a>
        <a asp-action="Index" class="btn-ghost">Back</a>
    </div>
}

<div class="card-surface p-6 max-w-2xl">
    <dl class="space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">User</dt><dd>@Model.User?.UserName</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Resource</dt><dd>@(Model.RDPResource?.Name ?? Model.RDPResourceId)</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Stored credentials</dt><dd>@(Model.HasStoredCredentials ? "Yes" : "No")</dd></div>
    </dl>
</div>
