@model KSol.RDPGateway.Models.RDPResourceUserAuthorization

@{
    ViewData["Title"] = "Revoke access";
}

<div class="card-surface p-6 max-w-2xl">
    <div class="w-12 h-12 rounded-full bg-destructive/10 text-destructive flex items-center justify-center mb-4">
        <i class="ri-shield-cross-line text-2xl"></i>
    </div>
    <h1 class="text-xl font-semibold">Revoke access?</h1>
    <p class="text-muted-foreground mt-1">
        Revoke <strong>@Model.User?.UserName</strong>'s access to
        <strong>@(Model.RDPResource?.Name ?? Model.RDPResourceId)</strong>.
    </p>
    <form asp-action="Delete" class="flex items-center gap-2 mt-6">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-destructive">Revoke access</button>
        <a asp-action="Index" class="btn-ghost">Cancel</a>
    </form>
</div>
