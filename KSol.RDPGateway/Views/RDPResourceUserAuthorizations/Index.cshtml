@model IEnumerable<KSol.RDPGateway.Models.RDPResourceUserAuthorization>

@{
    ViewData["Title"] = "Authorizations";
    ViewData["Subtitle"] = "Which users may connect to which resources.";
}

@section PageActions {
    <a asp-action="Create" class="btn-primary w-fit"><i class="ri-add-line"></i> Grant access</a>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-shield-user-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No authorizations yet</h3>
        <p class="text-sm text-muted-foreground mt-1">Grant a user access to a resource to let them connect.</p>
        <a asp-action="Create" class="btn-primary mt-4"><i class="ri-add-line"></i> Grant access</a>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>User</th>
                <th>Resource</th>
                <th>Credentials</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="font-medium">@item.User?.UserName</td>
                <td>@(item.RDPResource?.Name ?? item.RDPResourceId)</td>
                <td>
                    @if (item.HasStoredCredentials)
                    {
                        <span class="badge bg-success/10 text-success"><i class="ri-key-2-line"></i> Stored</span>
                    }
                    else
                    {
                        <span class="badge-muted">None</span>
                    }
                </td>
                <td>
                    <div class="flex items-center justify-end gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-secondary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Revoke</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
