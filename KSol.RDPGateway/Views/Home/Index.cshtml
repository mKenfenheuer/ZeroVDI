@model IEnumerable<KSol.RDPGateway.Models.RDPResource>
@using KSol.RDPGateway.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_UserLayout";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold">Your desktops</h1>
    <p class="text-muted-foreground mt-1">Connect to a remote desktop right in your browser.</p>
</div>

@if (User.Identity?.IsAuthenticated == false)
{
    <div class="flex items-start gap-3 p-4 rounded-xl border border-border bg-info/5 text-foreground">
        <i class="ri-information-line text-xl text-info"></i>
        <div>
            <p class="font-medium">Welcome</p>
            <p class="text-sm text-muted-foreground">Please <a asp-page="/Account/Login" class="text-primary hover:underline">sign in</a> to access your remote desktops.</p>
        </div>
    </div>
}
else if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 rounded-2xl border border-dashed border-border bg-card">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-computer-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No desktops assigned</h3>
        <p class="text-sm text-muted-foreground mt-1 max-w-sm">You don't have access to any remote desktops yet. Contact an administrator to get assigned.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var resource in Model)
        {
            var coldStart = resource.PowerState == ResourcePowerState.Stopped
                         || resource.PowerState == ResourcePowerState.Suspended;
            <div class="group bg-card text-card-foreground border border-border rounded-2xl p-5 flex flex-col shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                            <i class="ri-computer-line text-xl"></i>
                        </div>
                        <h3 class="font-semibold truncate" title="@resource.Name">@resource.Name</h3>
                    </div>
                    <partial name="_PowerStateBadge" model="resource.PowerState" />
                </div>

                @if (!string.IsNullOrEmpty(resource.Description))
                {
                    <p class="text-sm text-muted-foreground mt-3 line-clamp-2">@resource.Description</p>
                }

                <div class="mt-5 pt-4 border-t border-border">
                    <a asp-controller="Connect" asp-action="Index" asp-route-id="@resource.Id"
                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition-opacity">
                        <i class="ri-play-circle-line text-base"></i> Connect
                    </a>
                </div>
            </div>
        }
    </div>
}
