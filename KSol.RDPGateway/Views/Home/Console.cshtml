@using KSol.RDPGateway.Models
@{
    Layout = null;
    var resourceId = ViewData["ResourceId"] as string;
    var resourceName = ViewData["ResourceName"] as string;
    var autoConnect = ViewData["AutoConnect"] is true;
    // SSO auto-connect never receives the real stored credentials (the gateway injects them
    // server-side). The browser uses harmless placeholders purely so the form submits and the inner
    // handshake frames are well-formed; client.js suppresses the credentials WS frame when AutoConnect
    // is set, and the gateway's MITM replaces any inner Client Info creds with the stored ones.
    var storedUser = autoConnect ? "sso" : "";
    var storedPassword = autoConnect ? "sso" : "";
    var storedDomain = "";
    var defaults = ViewData["Defaults"] as ConnectionDefaults;
    var recordingNotice = ViewData["RecordingNotice"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@resourceName — RDP Console</title>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        html, body { height: 100%; margin: 0; background: #1a1a1a; color: #eee; overflow: hidden; }

        /* Floating session control bar: auto-minimizes to a slim pill at the top center and
           auto-hides while you work; hovering the top edge (or moving the mouse) reveals it. */
        #floatbar {
            position: fixed; top: 8px; left: 50%; transform: translateX(-50%);
            z-index: 40; display: flex; align-items: center; gap: .4rem;
            padding: .25rem .4rem; border-radius: 999px;
            background: rgba(28,28,30,.92); border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 4px 18px rgba(0,0,0,.45); backdrop-filter: blur(6px);
            font-size: .82rem; transition: opacity .25s ease, transform .25s ease;
            max-width: 92vw;
        }
        /* Auto-hidden: slides up out of view and ignores pointer events until revealed. */
        #floatbar.hidden { opacity: 0; transform: translateX(-50%) translateY(-130%); pointer-events: none; }
        /* Minimized: collapses to just the grip + name + status; the controls are hidden. */
        #floatbar.min #floatbar-controls { display: none; }
        #floatbar .grip {
            cursor: pointer; padding: 0 .35rem; color: #9aa0a6; user-select: none; font-size: 1rem;
            line-height: 1;
        }
        #floatbar .name { font-weight: 600; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; max-width: 22vw; margin-left: 10px }
        #floatbar .status { color: #9bd; white-space: nowrap; }
        #floatbar-controls { display: flex; align-items: center; gap: .35rem; }
        #floatbar .btn { --bs-btn-padding-y: .15rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .78rem; }
        /* A thin invisible strip along the top edge to reveal the bar when it's auto-hidden. */
        #reveal-zone { position: fixed; top: 0; left: 30%; right: 30%; height: 5px; z-index: 39; }
        #screen-wrap {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            background: #000;
        }
        /* CSS size is set per-connection by client._fit() so the device-pixel backing store maps 1:1
           on HiDPI displays (crisp, no browser upscaling). */
        #canvas { background: #000; display: block; }
        #pointer-cache { display: none; }
        .pointer-cache-null { cursor: none; }
        .pointer-cache-default { cursor: default; }
        #login-overlay {
            position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center;
            background: rgba(0,0,0,.85);
        }
        #login-card { width: 360px; max-width: 90vw; background: #2a2a2a; border: 1px solid #444;
            border-radius: 8px; padding: 1.25rem; }
        #login-card h5 { margin-bottom: 1rem; }
        #login-card label { font-size: .8rem; color: #bbb; }
        .form-control { background: #1e1e1e; color: #eee; border-color: #555; }
        .form-control:focus { background: #1e1e1e; color: #eee; }
        #login-error { color: #f88; font-size: .85rem; min-height: 1.2em; }
        /* Auto-connect / SSO sessions never show the login form: it's hidden outright so the page goes
           straight to connecting. */
        #login-overlay.hidden { display: none !important; }

        /* Reconnect popup: a small centered card shown when an auto-connect (SSO) session drops, instead
           of bringing back the full login form. One button re-establishes the session. */
        #reconnect-overlay {
            position: fixed; inset: 0; z-index: 32; display: none; align-items: center; justify-content: center;
            background: rgba(0,0,0,.85);
        }
        #reconnect-overlay.show { display: flex; }
        #reconnect-card {
            width: 320px; max-width: 90vw; background: #2a2a2a; border: 1px solid #444;
            border-radius: 8px; padding: 1.25rem; text-align: center;
        }
        #reconnect-card h5 { margin-bottom: .75rem; }
        #reconnect-msg { color: #bbb; font-size: .85rem; min-height: 1.2em; margin-bottom: 1rem; }
        .btn-session-control {
            appearance: none;
            background: transparent;
            border: none;
            color: #fff;
            padding: 6px 10px;
            cursor: pointer;
            border-radius: 1rem;
            transition: background-color 0.2s ease;
        }

        .btn-session-control:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .fa-red {
            color: #f00;
        }

        /* Recording indicator: a 5px red frame around the whole session and a dismissible banner.
           Both are only rendered when the recording rule asks to notify the user. The frame sits above
           the canvas but ignores pointer events so it never intercepts clicks meant for the desktop. */
        #rec-frame {
            position: fixed; inset: 0; z-index: 35; pointer-events: none;
            border: 5px solid #e3342f; box-sizing: border-box;
        }
        #rec-banner {
            position: fixed; top: 8px; left: 50%; transform: translateX(-50%);
            z-index: 50; display: flex; align-items: center; gap: .55rem;
            padding: .4rem .65rem .4rem .8rem; border-radius: 999px;
            background: rgba(227,52,47,.95); color: #fff; font-size: .82rem; font-weight: 600;
            box-shadow: 0 4px 18px rgba(0,0,0,.45);
            transition: opacity .3s ease, transform .3s ease;
        }
        #rec-banner.hidden { opacity: 0; transform: translateX(-50%) translateY(-130%); pointer-events: none; }
        #rec-banner .rec-dot {
            width: .6rem; height: .6rem; border-radius: 50%; background: #fff;
            animation: rec-blink 1.4s ease-in-out infinite;
        }
        @@keyframes rec-blink { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
        #rec-banner .rec-close {
            appearance: none; background: transparent; border: none; color: #fff;
            cursor: pointer; padding: 0 .15rem; font-size: .9rem; line-height: 1; opacity: .85;
        }
        #rec-banner .rec-close:hover { opacity: 1; }

        /* Clipboard overlay: a small popup panel holding a textarea kept in sync with the remote
           session's clipboard. Browser clipboard autosync is unfeasible (gesture + permission per
           read), so the user edits this box and pushes its contents to the remote on demand; text the
           remote copies is shown here. Centered modal-style panel dimmed over the session. */
        #clip-overlay {
            position: fixed; inset: 0; z-index: 45; display: none;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,.55);
        }
        #clip-overlay.show { display: flex; }
        #clip-card {
            width: 520px; max-width: 92vw; background: #2a2a2a; border: 1px solid #444;
            border-radius: 8px; padding: 1rem 1.1rem; box-shadow: 0 8px 30px rgba(0,0,0,.5);
        }
        #clip-card h6 { margin: 0 0 .25rem; font-weight: 600; }
        #clip-card .clip-sub { font-size: .76rem; color: #999; margin-bottom: .6rem; }
        #clip-text {
            width: 100%; min-height: 180px; resize: vertical; font-family: var(--bs-font-monospace, monospace);
            font-size: .85rem; background: #1e1e1e; color: #eee; border: 1px solid #555;
            border-radius: 6px; padding: .5rem .6rem;
        }
        #clip-text:focus { outline: none; border-color: #6aa7ff; }
        #clip-actions { display: flex; align-items: center; gap: .5rem; margin-top: .65rem; }
        #clip-actions .clip-hint { font-size: .74rem; color: #8c9; margin-left: auto; min-height: 1em; }
        #clip-actions .clip-hint.muted { color: #888; }
    </style>
</head>
<body>
    @if (recordingNotice)
    {
        @* Recording disclosure — shown only when the matched recording rule has NotifyUser=true. The red
           frame and banner appear once the session is connected (see the "ready" status handler). *@
        <div id="rec-frame" style="display:none;"></div>
        <div id="rec-banner" class="hidden">
            <span class="rec-dot"></span>
            <span>This session is being recorded</span>
            <button type="button" class="rec-close" id="rec-banner-close" title="Dismiss">&times;</button>
        </div>
    }
    <div id="reveal-zone"></div>
    <div id="floatbar" class="hidden">
        <span class="name">@resourceName</span>
        <span id="floatbar-controls">
            <button class="btn-session-control" id="btn-clip" type="button"
                    title="Clipboard — sync text with the remote session"><i class="fa-solid fa-clipboard"></i></button>
            <button class="btn-session-control" id="btn-fullscreen" type="button"><i class="fa-solid fa-expand"></i></button>
            <button class="btn-session-control" id="btn-mute" type="button" actiontitle="Mute / unmute remote sound"><i class="fa-solid fa-volume"></i></button>
            <button class="btn-session-control fa-red" id="btn-disable-video" type="button"><i class="fa-solid fa-video-slash"></i></button>
            <button class="btn-session-control fa-red" id="btn-disable-microphone" type="button"><i class="fa-solid fa-microphone-slash"></i></button>
            <button class="btn-session-control fa-red" id="btn-disconnect" type="button" disabled><i class="fa-solid fa-link-slash"></i></button>
        </span>
    </div>

    <div id="screen-wrap">
        <canvas id="canvas" width="1280" height="800"></canvas>
        <canvas id="pointer-cache" width="32" height="32"></canvas>
    </div>

    @* Clipboard overlay — manual text sync with the remote session (see #clip-overlay styles). Toggled
       by the floatbar clipboard button. The textarea shows text the remote copied and is the source for
       "Send to remote". *@
    <div id="clip-overlay">
        <div id="clip-card">
            <h6>Clipboard</h6>
            <div class="clip-sub">Edit the text and send it to the remote session, or copy text the
                remote put on its clipboard from here.</div>
            <textarea id="clip-text" placeholder="Type or paste text here, then “Send to remote”…"></textarea>
            <div id="clip-actions">
                <button class="btn btn-primary btn-sm" type="button" id="clip-send">Send to remote</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" id="clip-copy">Copy</button>
                <button class="btn btn-outline-secondary btn-sm" type="button" id="clip-close">Close</button>
                <span class="clip-hint" id="clip-hint"></span>
            </div>
        </div>
    </div>

    @* Reconnect popup — shown when an auto-connect (SSO) session drops. The full login form is hidden
       for SSO sessions, so instead of re-rendering it on disconnect we offer a single Reconnect button. *@
    <div id="reconnect-overlay">
        <div id="reconnect-card">
            <h5>Session disconnected</h5>
            <div id="reconnect-msg"></div>
            <div class="d-grid">
                <button class="btn btn-primary btn-sm" type="button" id="btn-reconnect">Reconnect</button>
            </div>
        </div>
    </div>

    <div id="login-overlay" class="@(autoConnect ? "hidden" : "")">
        <div id="login-card">
            <h5>Connect to @resourceName</h5>
            <form id="login-form" autocomplete="off">
                <div class="mb-2">
                    <label for="vm-user">Username</label>
                    <input class="form-control form-control-sm" id="vm-user" value="@storedUser" autocomplete="username" />
                </div>
                <div class="mb-2">
                    <label for="vm-pass">Password</label>
                    <input class="form-control form-control-sm" id="vm-pass" type="password" value="@storedPassword" autocomplete="current-password" />
                </div>
                <div class="mb-2">
                    <label for="vm-domain">Domain <span class="text-muted">(optional)</span></label>
                    <input class="form-control form-control-sm" id="vm-domain" value="@storedDomain" />
                </div>

                <details class="mb-2">
                    <summary style="cursor:pointer; font-size:.82rem; color:#bbb;">Session options</summary>
                    <div class="mt-2">
                        <div class="form-check form-check-sm">
                            <input class="form-check-input" type="checkbox" id="opt-audio" checked="@(defaults?.Audio ?? true)" />
                            <label class="form-check-label" for="opt-audio" style="font-size:.82rem;">Remote sound</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input" type="checkbox" id="opt-clipboard" checked="@(defaults?.Clipboard ?? true)" />
                            <label class="form-check-label" for="opt-clipboard" style="font-size:.82rem;">Clipboard sync</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input" type="checkbox" id="opt-microphone" checked="@(defaults?.Microphone ?? true)"/>
                            <label class="form-check-label" for="opt-microphone" style="font-size:.82rem;">Microphone (prompts for permission)</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input" type="checkbox" id="opt-camera" checked="@(defaults?.Camera ?? true)"/>
                            <label class="form-check-label" for="opt-camera" style="font-size:.82rem;">Camera (prompts for permission)</label>
                        </div>

                        <div class="mt-2" style="font-size:.78rem; color:#999;">Display mode</div>
                        @* GFX graphics pipeline + codec. "Legacy bitmaps" = the classic fastpath path
                           (most compatible). The GFX modes use MS-RDPEGFX surfaces; H.264 needs the host
                           to grant AVC over GFX (server GPU + the "Prioritize H.264/AVC 444" policy),
                           otherwise the host streams ClearCodec, which we also decode. *@
                        @{ var gfxMode = defaults?.GfxMode ?? "avc420"; }
                        <select class="form-select form-select-sm" id="opt-gfx-mode" style="font-size:.82rem; max-width: 22rem;">
                            <option value="off" selected="@(gfxMode == "off")">Legacy bitmaps (most compatible)</option>
                            <option value="clearcodec" selected="@(gfxMode == "clearcodec")">GFX — ClearCodec</option>
                            <option value="avc420" selected="@(gfxMode == "avc420")">GFX — H.264 (AVC420), fallback ClearCodec</option>
                            <option value="avc444" selected="@(gfxMode == "avc444")">GFX — H.264 (AVC444), fallback ClearCodec</option>
                        </select>

                        <div class="mt-2" style="font-size:.78rem; color:#999;">Visual quality</div>
                        @* Performance flags. Checked = the named eye-candy / quality feature is ON.
                           Defaults below favour better visuals (font smoothing + composition, all
                           eye-candy left on). The data-perf attribute holds the RDP flag bit. *@
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-font" data-perf="ENABLE_FONT_SMOOTHING" checked />
                            <label class="form-check-label" for="perf-font" style="font-size:.82rem;">Font smoothing (anti-alias)</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-comp" data-perf="ENABLE_DESKTOP_COMPOSITION" checked />
                            <label class="form-check-label" for="perf-comp" style="font-size:.82rem;">Desktop composition (Aero)</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-wallpaper" data-perf="DISABLE_WALLPAPER" data-invert="1" checked />
                            <label class="form-check-label" for="perf-wallpaper" style="font-size:.82rem;">Wallpaper</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-theming" data-perf="DISABLE_THEMING" data-invert="1" checked />
                            <label class="form-check-label" for="perf-theming" style="font-size:.82rem;">Themes</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-drag" data-perf="DISABLE_FULLWINDOWDRAG" data-invert="1" checked />
                            <label class="form-check-label" for="perf-drag" style="font-size:.82rem;">Show window contents while dragging</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-menu" data-perf="DISABLE_MENUANIMATIONS" data-invert="1" checked />
                            <label class="form-check-label" for="perf-menu" style="font-size:.82rem;">Menu animations</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-cursorshadow" data-perf="DISABLE_CURSOR_SHADOW" data-invert="1" checked />
                            <label class="form-check-label" for="perf-cursorshadow" style="font-size:.82rem;">Cursor shadow</label>
                        </div>
                        <div class="form-check form-check-sm">
                            <input class="form-check-input perf-flag" type="checkbox" id="perf-cursorsettings" data-perf="DISABLE_CURSORSETTINGS" data-invert="1" checked />
                            <label class="form-check-label" for="perf-cursorsettings" style="font-size:.82rem;">Cursor blink</label>
                        </div>
                    </div>
                </details>

                <div class="form-check form-check-sm mt-2">
                    <input class="form-check-input" type="checkbox" id="opt-store-creds" />
                    <label class="form-check-label" for="opt-store-creds" style="font-size:.82rem;">Store credentials for next time</label>
                </div>
                <div class="form-check form-check-sm">
                    <input class="form-check-input" type="checkbox" id="opt-remember-settings" />
                    <label class="form-check-label" for="opt-remember-settings" style="font-size:.82rem;">Remember these settings</label>
                </div>

                <div id="login-error"></div>
                <div class="d-grid mt-2">
                    <button class="btn btn-primary btn-sm" type="submit" id="btn-connect">Connect</button>
                </div>
                <p class="text-muted mt-2 mb-0" style="font-size:.72rem;">
                    Credentials authenticate the desktop (NLA) over this HTTPS connection. When “Store credentials”
                    is checked they are saved encrypted to your account for one-click reconnect.
                </p>
            </form>
        </div>
    </div>

    @* The RLE wasm module auto-initializes on load and exposes a global `Module`. *@
    <script>
        // locateFile lets the emscripten loader find the .wasm next to the .js under /lib/rdpweb/rle/.
        var Module = { locateFile: function (p) { return "/lib/rdpweb/rle/" + p; } };
    </script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>

    @* asp-append-version stamps a content hash onto each src (?v=…) so a changed file is always
       refetched — browsers cache these static JS aggressively, which silently served stale code while
       iterating on the camera channel. *@
    <script src="~/lib/rdpweb/rle/ms-rle-wasm.js" asp-append-version="true"></script>

    <script src="~/lib/rdpweb/binary.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/color.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/header.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/bitmap.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/pointer.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/header.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/keymap.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/keyboard.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/mouse.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpsnd.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/audin.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpecam.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/cliprdr.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/zgfx.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/mppc.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/clear.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/progressive.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpgfx.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/protocol.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/client.js" asp-append-version="true"></script>

    <script>
        // SSO auto-connect: when the gateway has stored credentials + defaults for this (user,
        // resource), it renders these so the page connects on load without the login overlay. The
        // gateway also has the credentials for NLA, so client.js must NOT send a credentials frame.
        window.RDP_AUTOCONNECT = @(autoConnect ? "true" : "false");
        window.RDP_DEFAULT_PERF = @(defaults?.PerformanceFlags ?? 0);
        window.RDP_RESOURCE_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resourceId));
    </script>
    <script>
        (function () {
            var wsUrl = "/ws/rdp/@resourceId";
            var loginOverlay = document.getElementById("login-overlay");
            var loginError = document.getElementById("login-error");
            var reconnectOverlay = document.getElementById("reconnect-overlay");
            var reconnectMsg = document.getElementById("reconnect-msg");
            var btnReconnect = document.getElementById("btn-reconnect");
            var btnConnect = document.getElementById("btn-connect");
            var btnDisconnect = document.getElementById("btn-disconnect");
            var btnFullscreen = document.getElementById("btn-fullscreen");
            var btnMute = document.getElementById("btn-mute");
            var btnDisableMic = document.getElementById("btn-disable-microphone");
            var btnDisableVideo = document.getElementById("btn-disable-video");
            var btnClip = document.getElementById("btn-clip");
            var clipOverlay = document.getElementById("clip-overlay");
            var clipText = document.getElementById("clip-text");
            var clipHint = document.getElementById("clip-hint");
            var btnClipSend = document.getElementById("clip-send");
            var btnClipCopy = document.getElementById("clip-copy");
            var btnClipClose = document.getElementById("clip-close");
            var floatbar = document.getElementById("floatbar");
            var revealZone = document.getElementById("reveal-zone");

            // ---- recording disclosure -----------------------------------------------------------------
            // Present only when the recording rule asked to notify (server-rendered #rec-frame/#rec-banner).
            // On connect: show the red frame + banner; auto-hide the banner after 30s (frame stays for the
            // whole session). The close button dismisses the banner early. Both hide when the session ends.
            var recFrame = document.getElementById("rec-frame");
            var recBanner = document.getElementById("rec-banner");
            var recBannerTimer = null;
            function showRecording() {
                if (!recFrame) return;
                recFrame.style.display = "block";
                recBanner.classList.remove("hidden");
                if (recBannerTimer) clearTimeout(recBannerTimer);
                recBannerTimer = setTimeout(function () { recBanner.classList.add("hidden"); }, 30000);
            }
            function hideRecording() {
                if (!recFrame) return;
                if (recBannerTimer) clearTimeout(recBannerTimer);
                recFrame.style.display = "none";
                recBanner.classList.add("hidden");
            }
            if (recBanner) {
                document.getElementById("rec-banner-close").addEventListener("click", function () {
                    if (recBannerTimer) clearTimeout(recBannerTimer);
                    recBanner.classList.add("hidden");
                });
            }

            var screenWrap = document.getElementById("screen-wrap");
            var canvas = document.getElementById("canvas");
            var client = new Client(wsUrl, "canvas");

            // Return the console to its pre-connect state: blank the screen and bring back a way to
            // reconnect. For an SSO/auto-connect session the login form stays hidden — we show the small
            // centered Reconnect popup instead. For a manual session we re-show the login form.
            function resetConsole(message) {
                var ctx = canvas.getContext("2d");
                if (ctx) { ctx.fillStyle = "#000"; ctx.fillRect(0, 0, canvas.width, canvas.height); }
                btnDisconnect.disabled = true;
                btnConnect.disabled = false;
                btnConnect.textContent = "Connect";
                if (hideTimer) clearTimeout(hideTimer);
                floatbar.classList.add("hidden");
                hideRecording();
                clipOverlay.classList.remove("show"); // hide the clipboard popup when the session ends
                if (window.RDP_AUTOCONNECT) {
                    reconnectMsg.textContent = message || "";
                    reconnectOverlay.classList.add("show");
                } else {
                    loginError.textContent = message || "";
                    loginOverlay.classList.remove("hidden");
                    loginOverlay.style.display = "flex";
                }
            }

            client.setStatusCallback(function (status, message) {
                switch (status) {
                    case "connecting":
                        break;
                    case "ready":
                        loginOverlay.style.display = "none";
                        reconnectOverlay.classList.remove("show");
                        btnDisconnect.disabled = false;
                        showBar();          // reveal the floating bar on connect, then auto-hide
                        scheduleAutoHide();
                        showRecording();    // red frame + recording banner (no-op when not notifying)
                        break;
                    case "error":
                        // For SSO/auto-connect, resetConsole() shows the Reconnect popup (with the error
                        // as its message); for a manual session it re-shows the login form.
                        if (window.RDP_AUTOCONNECT) {
                            resetConsole(message || "Connection failed");
                        } else {
                            loginError.textContent = message || "Connection failed";
                            loginOverlay.classList.remove("hidden");
                            loginOverlay.style.display = "flex";
                            btnConnect.disabled = false;
                            btnConnect.textContent = "Connect";
                            btnDisconnect.disabled = true;
                            floatbar.classList.add("hidden");
                            hideRecording();
                        }
                        break;
                    case "closed":
                        // Session ended (user disconnect or server drop): reset the screen to black and
                        // offer a way to reconnect. `message`, when present, is the host's disconnect
                        // reason (logoff, admin disconnect, timeout) — show it so the user knows why.
                        resetConsole(message);
                        break;
                }
            });

            document.getElementById("login-form").addEventListener("submit", function (e) {
                e.preventDefault();
                loginError.textContent = "";
                var user = document.getElementById("vm-user").value;
                var pass = document.getElementById("vm-pass").value;
                var domain = document.getElementById("vm-domain").value;
                if (!user) { loginError.textContent = "Username is required."; return; }
                btnConnect.disabled = true;
                btnConnect.textContent = "Connecting…";

                // Build the RDP performanceFlags from the checkboxes. For a plain ENABLE_* flag,
                // checked = set the bit. For a DISABLE_* flag marked data-invert, the checkbox means
                // "keep this eye-candy" — so UNchecked sets the DISABLE bit.
                var perf = 0;
                var PERF = window.RDP_PERF || {};
                document.querySelectorAll(".perf-flag").forEach(function (cb) {
                    var bit = PERF[cb.getAttribute("data-perf")] || 0;
                    var invert = cb.getAttribute("data-invert") === "1";
                    if (invert ? !cb.checked : cb.checked) perf |= bit;
                });

                client.setAudioEnabled(true);
                client.setMuted(document.getElementById("opt-audio").checked);
                var muted = !(client.muted);
                client.setMuted(muted);
                if(muted) {
                    btnMute.classList.add("fa-red");
                } else {
                    btnMute.classList.remove("fa-red");
                }
                btnMute.innerHTML = muted ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume"></i>';

                client.setClipboardEnabled(document.getElementById("opt-clipboard").checked);

                // Microphone redirection must be decided BEFORE connect (the AUDIO_INPUT DVC is only
                // accepted if enabled at handshake time). The floatbar mic button then mutes/unmutes
                // capture at runtime. Reflect the initial state on the button.
                var micOn = document.getElementById("opt-microphone").checked;
                client.setMicrophoneEnabled(micOn);
                client.setMicMuted(!micOn);
                btnDisableMic.classList.toggle("fa-red", !micOn);
                btnDisableMic.innerHTML = micOn ? '<i class="fa-solid fa-microphone"></i>' : '<i class="fa-solid fa-microphone-slash"></i>';

                // Camera redirection — same pattern: decided before connect (the RDPECAM DVCs are only
                // accepted when enabled at handshake); the floatbar video button pauses/resumes at runtime.
                var camOn = document.getElementById("opt-camera").checked;
                client.setCameraEnabled(camOn);
                client.setCameraPaused(!camOn);
                btnDisableVideo.classList.toggle("fa-red", !camOn);
                btnDisableVideo.innerHTML = camOn ? '<i class="fa-solid fa-video"></i>' : '<i class="fa-solid fa-video-slash"></i>';

                // Create/resume the AudioContext now, inside this user gesture — browsers block audio
                // that starts without one, and the first wave arrives long after the click.
                if (client.audioEnabled) client.primeAudio();

                // GFX display mode (graphics pipeline + codec). Decided before connect: it controls the
                // CS_CORE GFX advertisement and the RDPGFX capsets. The dropdown is authoritative; the
                // ?gfx=<mode> URL param still works when the dropdown is left at its default ("off").
                var gfxSel = document.getElementById("opt-gfx-mode");
                var gfxMode = gfxSel ? gfxSel.value : "off";
                if (gfxMode === "off") {
                    var urlGfx = new URLSearchParams(window.location.search).get("gfx");
                    if (urlGfx) gfxMode = urlGfx; // honor the URL override only when UI is at default
                }
                window.RDP_GFX_MODE = gfxMode;

                // Optionally persist credentials / settings to this user's authorization (best-effort,
                // fire-and-forget so it never blocks the connect). The server stores credentials
                // encrypted; settings become this resource's connect defaults for the user.
                var storeCreds = document.getElementById("opt-store-creds");
                var rememberSettings = document.getElementById("opt-remember-settings");
                if ((storeCreds && storeCreds.checked) || (rememberSettings && rememberSettings.checked)) {
                    var body = {
                        storeCredentials: !!(storeCreds && storeCreds.checked),
                        rememberSettings: !!(rememberSettings && rememberSettings.checked),
                        username: user, password: pass, domain: domain,
                        audio: document.getElementById("opt-audio").checked,
                        clipboard: document.getElementById("opt-clipboard").checked,
                        microphone: micOn, camera: camOn,
                        gfxMode: gfxMode, performanceFlags: perf
                    };
                    fetch("/connect/" + encodeURIComponent(window.RDP_RESOURCE_ID) + "/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(body)
                    }).catch(function () { /* non-fatal */ });
                }

                // Pick a desktop resolution that fills the visible area in *device* pixels (crisp on
                // HiDPI), bake it into the handshake by sizing the canvas before connecting.
                var size = client.chooseDesktopSize(screenWrap);
                client.applyDesktopSize(screenWrap, size);
                client.connect({ user: user, password: pass, domain: domain, performanceFlags: perf });
            });

            btnDisconnect.addEventListener("click", function () { client.disconnect(); });
            // Reconnect popup button (SSO sessions): re-submit the hidden login form, which still holds
            // the SSO field values + options, to re-establish the session.
            btnReconnect.addEventListener("click", function () {
                reconnectOverlay.classList.remove("show");
                reconnectMsg.textContent = "";
                var form = document.getElementById("login-form");
                if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event("submit", { cancelable: true }));
            });
            btnFullscreen.addEventListener("click", function () {
                if (!document.fullscreenElement) {
                    (screenWrap.requestFullscreen ? screenWrap.requestFullscreen() : Promise.reject()).catch(function () {});
                } else {
                    document.exitFullscreen();
                }
            });
            btnMute.addEventListener("click", function () {
                var muted = !(client.muted);
                client.setMuted(muted);
                if(muted) {
                    btnMute.classList.add("fa-red");
                } else {
                    btnMute.classList.remove("fa-red");
                }
                btnMute.innerHTML = muted ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume"></i>';
            });
            // Floatbar mic button: mute/unmute capture at runtime. (Whether the AUDIO_INPUT channel
            // exists at all is decided at connect from the "Microphone" option.) If the channel wasn't
            // enabled this session, the button just stays in the muted/slashed state.
            btnDisableMic.addEventListener("click", function () {
                if (!client.microphoneEnabled) return; // no mic channel this session
                var muted = !(client.micMuted);
                client.setMicMuted(muted);
                btnDisableMic.classList.toggle("fa-red", muted);
                btnDisableMic.innerHTML = muted ? '<i class="fa-solid fa-microphone-slash"></i>' : '<i class="fa-solid fa-microphone"></i>';
            });
            // Floatbar video button: pause/resume the camera feed at runtime (sends black frames while
            // paused). Whether the camera channel exists at all is decided at connect from the "Camera"
            // option; if it wasn't enabled this session the button stays in the slashed state.
            btnDisableVideo.addEventListener("click", function () {
                if (!client.cameraEnabled) return; // no camera channel this session
                var paused = !(client.cameraPaused);
                client.setCameraPaused(paused);
                btnDisableVideo.classList.toggle("fa-red", paused);
                btnDisableVideo.innerHTML = paused ? '<i class="fa-solid fa-video-slash"></i>' : '<i class="fa-solid fa-video"></i>';
            });
            // ---- clipboard overlay -------------------------------------------------------------------
            // Browser clipboard autosync is unfeasible (per-read gesture + permission), so clipboard
            // sync is manual: a popup textarea. The remote's copied text is pushed into the box, and the
            // box's contents are sent to the remote on "Send to remote".
            function setClipHint(msg, muted) {
                clipHint.textContent = msg || "";
                clipHint.classList.toggle("muted", !!muted);
            }
            function openClip() {
                if (clipOverlay.classList.contains("show")) return;
                clipOverlay.classList.add("show");
                setClipHint("");
                clipText.focus();
                clipText.select();
            }
            function closeClip() { clipOverlay.classList.remove("show"); }

            // Remote copied text → surface it in the textarea (the latest remote copy is the newest
            // event, so it replaces the box contents; a hint flags it when the popup is open).
            client.setRemoteClipboardCallback(function (text) {
                clipText.value = text == null ? "" : text;
                if (clipOverlay.classList.contains("show")) {
                    setClipHint("Received from remote", true);
                }
            });

            btnClip.addEventListener("click", function () {
                if (clipOverlay.classList.contains("show")) closeClip(); else openClip();
            });
            btnClipSend.addEventListener("click", function () {
                client.sendClipboardText(clipText.value);
                setClipHint("Sent to remote — paste in the session");
            });
            btnClipCopy.addEventListener("click", function () {
                clipText.focus();
                clipText.select();
                var ok = false;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(clipText.value).then(function () {
                        setClipHint("Copied to your clipboard", true);
                    }).catch(function () { setClipHint("Press Ctrl/Cmd+C to copy", true); });
                    return;
                }
                try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
                setClipHint(ok ? "Copied to your clipboard" : "Press Ctrl/Cmd+C to copy", true);
            });
            btnClipClose.addEventListener("click", closeClip);
            // Click the dimmed backdrop (outside the card) to dismiss.
            clipOverlay.addEventListener("mousedown", function (e) { if (e.target === clipOverlay) closeClip(); });
            // Esc closes; Ctrl/Cmd+Enter sends.
            clipText.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { e.preventDefault(); closeClip(); }
                else if ((e.ctrlKey || e.metaKey) && e.key === "Enter") { e.preventDefault(); btnClipSend.click(); }
            });

            // ---- floating bar: auto-hide + click-to-minimize ------------------------------------
            // The bar reveals on mouse activity near the top, stays while hovered, and auto-hides a
            // couple of seconds after you stop interacting with it. The grip toggles a minimized
            // (name + status only) state that persists across reveals.
            var hideTimer = null;
            function showBar() { floatbar.classList.remove("hidden"); }
            function scheduleAutoHide() {
                if (hideTimer) clearTimeout(hideTimer);
                hideTimer = setTimeout(function () {
                    if (!client.connected) return;     // keep it visible while disconnected
                    if (floatbar.matches(":hover")) { scheduleAutoHide(); return; }
                    floatbar.classList.add("hidden");
                }, 2200);
            }
            floatbar.addEventListener("mouseenter", function () { if (hideTimer) clearTimeout(hideTimer); });
            floatbar.addEventListener("mouseleave", scheduleAutoHide);
            // Reveal when the pointer reaches the top edge of the screen.
            revealZone.addEventListener("mouseenter", function () { showBar(); scheduleAutoHide(); });
            // Live remote resolution changes (MS-RDPEDISP). On a *genuine, settled* viewport change we
            // ask the server for a new resolution that fills the area. Guards against the spurious
            // resize/reflow events that fire right after connect (which must NOT trigger a layout —
            // doing so mid-stream changes the server's resolution and stalls output):
            //   - only after the session has been active for a moment,
            //   - debounced long enough to ignore transient settles,
            //   - only when the requested size differs meaningfully from what we last applied.
            var resizeTimer = null;
            function onViewportChange() {
                if (!client.connected) return;
                client._fit(screenWrap);                 // keep the current canvas fitted (cheap, no RDP)
                if (resizeTimer) clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    resizeTimer = null;
                    client.maybeResize(screenWrap);
                }, 600);
            }
            window.addEventListener("resize", onViewportChange);
            document.addEventListener("fullscreenchange", onViewportChange);

            window.addEventListener("beforeunload", function () { client.disconnect(); });

            // ---- SSO auto-connect -------------------------------------------------------------------
            // Reflect the stored PerformanceFlags onto the perf checkboxes (so the existing submit
            // handler reassembles the same mask), then submit the form programmatically. The submit
            // handler reads all fields/checkboxes exactly as for a manual login; the only difference is
            // client.js suppresses the credentials WS frame (window.RDP_AUTOCONNECT), since the gateway
            // already holds the credentials for NLA.
            if (window.RDP_AUTOCONNECT) {
                var PERF = window.RDP_PERF || {};
                var mask = window.RDP_DEFAULT_PERF | 0;
                document.querySelectorAll(".perf-flag").forEach(function (cb) {
                    var bit = PERF[cb.getAttribute("data-perf")] || 0;
                    var set = bit ? (mask & bit) !== 0 : false;
                    var invert = cb.getAttribute("data-invert") === "1";
                    // checked = "keep eye-candy": for an inverted (DISABLE_*) flag, checked means the
                    // bit is NOT set; for a plain ENABLE_* flag, checked means the bit IS set.
                    cb.checked = invert ? !set : set;
                });
                var form = document.getElementById("login-form");
                if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event("submit", { cancelable: true }));
            }
        })();
    </script>
</body>
</html>
