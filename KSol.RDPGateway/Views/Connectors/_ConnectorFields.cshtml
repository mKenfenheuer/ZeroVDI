@model KSol.RDPGateway.Models.Connector

<div>
    <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">Connector</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" placeholder="Berlin datacenter" />
            <span asp-validation-for="Name" class="form-error"></span>
        </div>
        <div>
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-input" placeholder="Reaches the 10.20.0.0/16 lab network" />
            <span asp-validation-for="Description" class="form-error"></span>
        </div>
        <div class="md:col-span-2">
            <label asp-for="AllowScope" class="form-label"></label>
            <textarea asp-for="AllowScope" class="form-input font-mono text-xs" rows="3"
                      placeholder="10.20.0.0/16&#10;host.internal.example.com"></textarea>
            <p class="text-xs text-muted-foreground mt-1">
                Optional. One host name or CIDR per line. Leave empty to let this connector serve any host
                (it is used only when it wins the round-trip-time probe).
            </p>
            <span asp-validation-for="AllowScope" class="form-error"></span>
        </div>
        <label class="md:col-span-2 flex items-center gap-2 text-sm cursor-pointer">
            <input asp-for="Enabled" class="form-check" />
            <span>@Html.DisplayNameFor(m => m.Enabled)</span>
        </label>
    </div>
</div>
