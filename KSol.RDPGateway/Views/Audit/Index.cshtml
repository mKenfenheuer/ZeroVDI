@model KSol.RDPGateway.Controllers.AuditIndexViewModel
@using KSol.RDPGateway.Models
@{
    ViewData["Title"] = "Audit log";
    ViewData["Subtitle"] = "Immutable record of authentication, session, credential and administrative activity.";

    string CategoryBadge(AuditCategory c) => c switch
    {
        AuditCategory.Authentication => "bg-info/10 text-info",
        AuditCategory.Session => "bg-success/10 text-success",
        AuditCategory.Credential => "bg-warning/10 text-warning",
        _ => "bg-muted text-muted-foreground",
    };
}

<form method="get" class="flex flex-wrap items-end gap-3 mb-5">
    <div>
        <label class="block text-xs font-medium text-muted-foreground mb-1">Category</label>
        <select name="category" class="input-surface" onchange="this.form.submit()">
            <option value="">All categories</option>
            @foreach (AuditCategory c in Enum.GetValues<AuditCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@c</option>
            }
        </select>
    </div>
    <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-muted-foreground mb-1">Search actor / target / action</label>
        <input type="text" name="q" value="@Model.Query" placeholder="e.g. admin@example.com" class="input-surface w-full" />
    </div>
    <button type="submit" class="btn-secondary btn-sm"><i class="ri-search-line"></i> Filter</button>
    @if (Model.Category != null || !string.IsNullOrWhiteSpace(Model.Query))
    {
        <a asp-action="Index" class="btn-outline btn-sm">Reset</a>
    }
</form>

@if (!Model.Events.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-history-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No audit events</h3>
        <p class="text-sm text-muted-foreground mt-1">Nothing matches the current filter.</p>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Time (UTC)</th>
                <th>Category</th>
                <th>Action</th>
                <th>Actor</th>
                <th>Target</th>
                <th>IP</th>
                <th>Result</th>
                <th>Detail</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td class="whitespace-nowrap">@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><span class="badge @CategoryBadge(e.Category)">@e.Category</span></td>
                <td class="font-medium">@e.Action</td>
                <td>@(e.ActorName ?? "—")</td>
                <td>@(e.TargetName ?? e.TargetId ?? "—")</td>
                <td class="text-muted-foreground">@(e.IpAddress ?? "—")</td>
                <td>
                    @if (e.Success)
                    {
                        <span class="badge bg-success/10 text-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-destructive/10 text-destructive">Failed</span>
                    }
                </td>
                <td class="text-muted-foreground text-xs max-w-[260px] truncate" title="@e.Detail">@e.Detail</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="flex items-center justify-between mt-4 text-sm text-muted-foreground">
        <span>@Model.TotalCount event@(Model.TotalCount == 1 ? "" : "s") · page @Model.Page of @Math.Max(1, Model.TotalPages)</span>
        <div class="flex gap-2">
            @if (Model.Page > 1)
            {
                <a class="btn-outline btn-sm" asp-action="Index"
                   asp-route-category="@Model.Category" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn-outline btn-sm" asp-action="Index"
                   asp-route-category="@Model.Category" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </div>
    </div>
}
