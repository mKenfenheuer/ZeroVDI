@model KSol.RDPGateway.Models.RDPResource
@using KSol.RDPGateway.Models

@{
    ViewData["Title"] = "Delete resource";
}

<h1 class="h3 mb-3">Delete resource</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <p class="lead">Are you sure you want to delete <strong>@Model.Name</strong>?</p>

        @if (Model.Source == ResourceSource.Proxmox)
        {
            <div class="alert alert-warning">
                This is a Proxmox-managed resource. Deleting it only removes the gateway entry and its
                user authorizations — the VM itself is not affected. It will be re-discovered on the
                next sync (with a new identity) unless you remove the <code>ksol-rdpgw-id</code> from
                the VM notes.
            </div>
        }

        <dl class="row">
            <dt class="col-sm-2">Source</dt>
            <dd class="col-sm-10">@Model.Source</dd>
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@(string.IsNullOrEmpty(Model.IpAddress) ? "—" : $"{Model.IpAddress}:{Model.Port}")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
