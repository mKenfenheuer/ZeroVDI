@model KSol.RDPGateway.Models.RDPResourceUserAuthorization

@{
    ViewData["Title"] = "Revoke access";
}

<h1 class="h3 mb-3">Revoke access</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <p class="lead">
            Revoke <strong>@Model.User?.UserName</strong>'s access to
            <strong>@(Model.RDPResource?.Name ?? Model.RDPResourceId)</strong>?
        </p>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Revoke</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
