@model IEnumerable<KSol.RDPGateway.Models.RDPResource>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Available RDP Resources</h1>
            <p class="text-muted">Click on a resource to start a session or download the RDP file.</p>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == false)
    {
        <div class="alert alert-info">
            <strong>Welcome!</strong> Please <a asp-area="Identity" asp-page="/Account/Login">sign in</a> to access RDP resources.
        </div>
    }
    else
    {
        var feedUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/rdweb/feed/webfeed.aspx";
        <div class="alert alert-secondary d-flex flex-column flex-md-row align-items-md-center gap-2">
            <div class="flex-grow-1">
                <strong>Use the Windows Remote Desktop app:</strong>
                add a <em>Workspace</em> / <em>Remote Resource Feed</em> with the URL below to see these
                resources directly in the app — no browser required.
                <div class="input-group input-group-sm mt-2">
                    <input type="text" class="form-control" id="feedUrl" value="@feedUrl" readonly />
                    <button class="btn btn-outline-secondary" type="button"
                            onclick="navigator.clipboard.writeText(document.getElementById('feedUrl').value)">
                        Copy
                    </button>
                </div>
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-warning">
                <strong>No Resources Available</strong> You don't have access to any RDP resources yet. Please contact an administrator.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var resource in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1">@resource.Name</h5>
                                    <partial name="_PowerStateBadge" model="resource.PowerState" />
                                </div>
                                @if (!string.IsNullOrEmpty(resource.Description))
                                {
                                    <p class="card-text text-muted">@resource.Description</p>
                                }
                                @if (resource.PowerState == KSol.RDPGateway.Models.ResourcePowerState.Stopped
                                    || resource.PowerState == KSol.RDPGateway.Models.ResourcePowerState.Suspended)
                                {
                                    <p class="card-text"><small class="text-secondary">
                                        This desktop will be started when you connect — the client will show
                                        “starting remote computer” for a moment.
                                    </small></p>
                                }
                            </div>
                            <div class="card-footer bg-light d-grid gap-2">
                                <a href="rdp://full%20address=s:@resource.Id&gatewayhostname=s:@Context.Request.Host.Host" class="btn btn-primary btn-sm">
                                    <i class="bi bi-play-circle"></i> Start Session
                                </a>
                                <a asp-action="DownloadRdpFile" asp-route-id="@resource.Id" class="btn btn-secondary btn-sm">
                                    <i class="bi bi-download"></i> Download .RDP File
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
