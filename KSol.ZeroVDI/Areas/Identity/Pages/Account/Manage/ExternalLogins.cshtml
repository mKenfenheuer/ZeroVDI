@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "External logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<h2 class="text-lg font-semibold mb-1">External logins</h2>
<p class="text-sm text-muted-foreground mb-6">Manage the external services you use to sign in.</p>
<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.CurrentLogins?.Count > 0)
{
    <h3 class="font-medium mb-2">Registered logins</h3>
    <table class="table-surface mb-6">
        <tbody>
            @foreach (var login in Model.CurrentLogins)
            {
                <tr>
                    <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                    <td class="text-right">
                        @if (Model.ShowRemoveButton)
                        {
                            <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                <button type="submit" class="btn-secondary btn-sm" title="Remove this @login.ProviderDisplayName login">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.OtherLogins?.Count > 0)
{
    <h3 class="font-medium mb-2">Add another service</h3>
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
        <div id="socialLoginList" class="flex flex-wrap gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn-secondary" name="provider" value="@provider.Name" title="Sign in using @provider.DisplayName">@provider.DisplayName</button>
            }
        </div>
    </form>
}
