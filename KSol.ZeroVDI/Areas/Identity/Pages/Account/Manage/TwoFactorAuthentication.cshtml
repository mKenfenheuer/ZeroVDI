@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="text-lg font-semibold mb-1">Two-factor authentication</h2>
<p class="text-sm text-muted-foreground mb-6">Add an extra layer of security to your account.</p>
<partial name="_StatusMessage" for="StatusMessage" />

@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
}
@if (consentFeature?.CanTrack ?? true)
{
    @if (Model.Is2faEnabled)
    {
        @if (Model.RecoveryCodesLeft == 0)
        {
            <div class="alert-error mb-4">
                <i class="ri-error-warning-line text-destructive text-lg"></i>
                <div class="text-sm"><strong>You have no recovery codes left.</strong> <a class="text-primary hover:underline" asp-page="./GenerateRecoveryCodes">Generate a new set</a> before you can use a recovery code.</div>
            </div>
        }
        else if (Model.RecoveryCodesLeft == 1)
        {
            <div class="alert-error mb-4">
                <i class="ri-error-warning-line text-destructive text-lg"></i>
                <div class="text-sm"><strong>You have 1 recovery code left.</strong> <a class="text-primary hover:underline" asp-page="./GenerateRecoveryCodes">Generate a new set</a>.</div>
            </div>
        }
        else if (Model.RecoveryCodesLeft <= 3)
        {
            <div class="alert-warning mb-4">
                <i class="ri-alert-line text-warning text-lg"></i>
                <div class="text-sm"><strong>You have @Model.RecoveryCodesLeft recovery codes left.</strong> <a class="text-primary hover:underline" asp-page="./GenerateRecoveryCodes">Generate a new set</a>.</div>
            </div>
        }

        <div class="flex flex-wrap gap-2 mb-6">
            @if (Model.IsMachineRemembered)
            {
                <form method="post" class="inline-block">
                    <button type="submit" class="btn-secondary">Forget this browser</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn-destructive">Disable 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn-secondary">Reset recovery codes</a>
        </div>
    }

    <h3 class="font-medium mb-2">Authenticator app
        @if (Model.HasAuthenticator)
        {
            <span class="badge bg-success/10 text-success ml-1"><i class="ri-check-line"></i> Enabled</span>
        }
    </h3>
    <div class="flex flex-wrap gap-2">
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn-primary">Add authenticator app</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn-secondary">Set up authenticator app</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn-secondary">Reset authenticator app</a>
        }
    </div>

    <h3 class="font-medium mb-2 mt-6">Email authentication
        @if (Model.HasEmailAuthenticator)
        {
            <span class="badge bg-success/10 text-success ml-1"><i class="ri-check-line"></i> Enabled</span>
        }
    </h3>
    <p class="text-sm text-muted-foreground mb-2">Receive a one-time code by email when you sign in.</p>
    <div class="flex flex-wrap gap-2">
        @if (!Model.HasEmailAuthenticator)
        {
            <a asp-page="./EnableEmailAuthenticator" class="btn-primary">Enable email authentication</a>
        }
        else
        {
            <a asp-page="./DisableEmailAuthenticator" class="btn-secondary">Disable email authentication</a>
        }
    </div>
}
else
{
    <div class="alert-error">
        <i class="ri-error-warning-line text-destructive text-lg"></i>
        <div class="text-sm"><strong>Privacy and cookie policy have not been accepted.</strong> You must accept the policy before enabling two-factor authentication.</div>
    </div>
}

@section Scripts { <partial name="_ValidationScripts" /> }
