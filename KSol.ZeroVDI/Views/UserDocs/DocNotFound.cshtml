@model KSol.ZeroVDI.RDP.DocPage
@{
    ViewData["Title"] = "Help";
    Layout = "_UserLayout";
}

<div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
    <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
        <i class="ri-file-search-line text-2xl text-muted-foreground"></i>
    </div>
    <h3 class="text-lg font-semibold">Page not found</h3>
    <p class="text-sm text-muted-foreground mt-1 max-w-md">That help page doesn't exist. It may have been moved or renamed.</p>
    <a href="/docs" class="btn-primary mt-5">
        <i class="ri-book-open-line"></i><span>Help home</span>
    </a>
</div>
