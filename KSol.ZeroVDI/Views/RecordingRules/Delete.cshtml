@model KSol.ZeroVDI.Models.RecordingRule
@{
    ViewData["Title"] = "Delete recording rule";
}

<div class="card-surface p-6 max-w-2xl">
    <div class="w-12 h-12 rounded-full bg-destructive/10 text-destructive flex items-center justify-center mb-4">
        <i class="ri-delete-bin-line text-2xl"></i>
    </div>
    <h1 class="text-xl font-semibold">Delete this rule?</h1>
    <p class="text-muted-foreground mt-1">Sessions will fall through to the next matching rule or the global default.</p>

    <dl class="space-y-2 text-sm my-6">
        <div class="flex gap-4"><dt class="text-muted-foreground w-28">Order</dt><dd>@Model.Order</dd></div>
        <div class="flex gap-4"><dt class="text-muted-foreground w-28">Scope</dt><dd>@Model.Scope</dd></div>
        <div class="flex gap-4"><dt class="text-muted-foreground w-28">Action</dt><dd>@Model.Action</dd></div>
        <div class="flex gap-4"><dt class="text-muted-foreground w-28">Description</dt><dd>@Model.Description</dd></div>
    </dl>

    <form asp-action="Delete" class="flex items-center gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-destructive">Delete rule</button>
        <a asp-action="Index" class="btn-ghost">Cancel</a>
    </form>
</div>
