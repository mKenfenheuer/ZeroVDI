@model KSol.ZeroVDI.Models.RecordingRule

<div asp-validation-summary="ModelOnly"></div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div>
        <label asp-for="Order" class="form-label">Order</label>
        <input asp-for="Order" class="form-input" />
        <p class="form-hint">Lower = first.</p>
    </div>
    <div>
        <label asp-for="Scope" class="form-label">Scope</label>
        <select asp-for="Scope" class="form-select" asp-items="Html.GetEnumSelectList<KSol.ZeroVDI.Models.RecordingRuleScope>()"></select>
    </div>
    <div>
        <label asp-for="Action" class="form-label">Action</label>
        <select asp-for="Action" class="form-select" asp-items="Html.GetEnumSelectList<KSol.ZeroVDI.Models.RecordingRuleAction>()"></select>
    </div>
    <label class="flex items-center gap-2 text-sm cursor-pointer self-end pb-2">
        <input asp-for="Enabled" class="form-check" />
        <span>Enabled</span>
    </label>
</div>

<div class="mt-4">
    <label class="flex items-start gap-2 text-sm cursor-pointer">
        <input asp-for="NotifyUser" class="form-check mt-0.5" />
        <span>Notify user (show a “this session is recorded” banner in the console)</span>
    </label>
    <p class="form-hint">Only applies when this rule records the session (Action = Allow).</p>
</div>

<p class="text-sm text-muted-foreground mt-5 mb-2">Fill the field matching the selected scope (the others are ignored):</p>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
        <label asp-for="UserId" class="form-label">User (scope = User)</label>
        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
            <option value="">— none —</option>
        </select>
    </div>
    <div>
        <label asp-for="RDPResourceId" class="form-label">Resource (scope = Resource)</label>
        <select asp-for="RDPResourceId" class="form-select" asp-items="ViewBag.RDPResourceId">
            <option value="">— none —</option>
        </select>
    </div>
    <div>
        <label asp-for="RoleName" class="form-label">Role (scope = Role)</label>
        <select asp-for="RoleName" class="form-select" asp-items="ViewBag.RoleName">
            <option value="">— none —</option>
        </select>
    </div>
</div>

<div class="mt-4">
    <label asp-for="Description" class="form-label">Description</label>
    <input asp-for="Description" class="form-input" />
</div>
