@model IReadOnlyList<KSol.ZeroVDI.RDP.ActiveSession>
@{
    ViewData["Title"] = "Active sessions";
    ViewData["Subtitle"] = "Live gateway tunnels. Force-disconnect terminates a session immediately.";
    var isAdmin = User.IsInRole("Admin");
    var now = DateTime.UtcNow;
}

@section PageActions {
    <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <span id="session-live" class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span> Live
        </span>
        <span>·</span>
        <span><span id="session-count">@Model.Count</span> active</span>
    </div>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-pulse-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No active sessions</h3>
        <p class="text-sm text-muted-foreground mt-1">Live console sessions will appear here.</p>
    </div>
}
else
{
    <div class="table-scroll">
        <table class="table-surface">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Resource</th>
                    <th>Host</th>
                    <th>Client IP</th>
                    <th>Started (UTC)</th>
                    <th>Duration</th>
                    @if (isAdmin)
                    {
                        <th class="text-right">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="font-medium">@(s.UserName ?? s.UserId)</td>
                    <td>@(s.ResourceName ?? s.ResourceId)</td>
                    <td class="text-muted-foreground">@(s.Host ?? "—")@(s.Port > 0 ? $":{s.Port}" : "")</td>
                    <td class="text-muted-foreground">@(s.ClientIp ?? "—")</td>
                    <td class="whitespace-nowrap">@s.StartedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="whitespace-nowrap tabular-nums" data-duration-since="@s.StartedUtc.ToString("o")">
                        @((now - s.StartedUtc).ToString(@"hh\:mm\:ss"))
                    </td>
                    @if (isAdmin)
                    {
                        <td>
                            <div class="flex items-center justify-end">
                                <form asp-action="Disconnect" asp-route-sessionId="@s.SessionId" method="post" class="inline"
                                      data-confirm="Force-disconnect this session? The user will be dropped immediately.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">
                                        <i class="ri-logout-box-r-line"></i> Disconnect
                                    </button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
    (function () {
        // Live-tick each session's duration client-side so the value doesn't go stale on the page.
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function tick() {
            var nowMs = Date.now();
            document.querySelectorAll('[data-duration-since]').forEach(function (el) {
                var start = Date.parse(el.getAttribute('data-duration-since'));
                if (isNaN(start)) return;
                var secs = Math.max(0, Math.floor((nowMs - start) / 1000));
                var h = Math.floor(secs / 3600), m = Math.floor((secs % 3600) / 60), s = secs % 60;
                el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
            });
        }
        setInterval(tick, 1000);
        tick();

        // Reload the list periodically so new/ended sessions appear without a manual refresh.
        // Skipped while the confirm dialog is open so we don't yank the page out from under a click.
        setInterval(function () {
            var modal = document.getElementById('confirm-modal');
            if (modal && !modal.classList.contains('hidden')) return;
            if (document.hidden) return;
            location.reload();
        }, 15000);
    })();
    </script>
}
