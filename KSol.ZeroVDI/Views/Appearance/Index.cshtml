@using KSol.ZeroVDI.Models
@model AppearanceSettings
@{
    ViewData["Title"] = "Appearance";
    ViewData["Subtitle"] = "Brand the interface and optionally force a color theme for all users.";

    var presets = new (string Key, string Label, string Swatch)[]
    {
        ("neutral", "Neutral", "bg-gray-900"),
        ("blue", "Blue", "bg-blue-500"),
        ("green", "Green", "bg-emerald-500"),
        ("orange", "Orange", "bg-orange-500"),
        ("rose", "Rose", "bg-rose-500"),
        ("slate", "Slate", "bg-slate-500"),
        ("sky", "Sky", "bg-sky-500"),
        ("azure", "Azure", "bg-indigo-500"),
    };
}

<div class="max-w-2xl space-y-6">

    <!-- Theme + mode policy -->
    <form method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div class="card-surface p-5">
            <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="ForceTheme" value="true" class="form-check mt-1"
                       @(Model.ForceTheme ? "checked" : "") data-toggle="theme-options" />
                <span>
                    <span class="font-medium block">Force a color theme</span>
                    <span class="text-sm text-muted-foreground">When on, all users get the theme below and the in-app color switcher is hidden.</span>
                </span>
            </label>

            <div id="theme-options" class="mt-4 space-y-4 @(Model.ForceTheme ? "" : "opacity-50 pointer-events-none")">
                <div class="flex gap-2">
                    <label class="flex-1 flex items-center gap-2 rounded-lg border border-border p-3 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                        <input type="radio" name="ThemeSource" value="@nameof(ThemeSource.Preset)" class="form-check"
                               @(Model.ThemeSource == ThemeSource.Preset ? "checked" : "") data-source="preset" />
                        <span class="text-sm font-medium">Preset theme</span>
                    </label>
                    <label class="flex-1 flex items-center gap-2 rounded-lg border border-border p-3 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                        <input type="radio" name="ThemeSource" value="@nameof(ThemeSource.Custom)" class="form-check"
                               @(Model.ThemeSource == ThemeSource.Custom ? "checked" : "") data-source="custom" />
                        <span class="text-sm font-medium">Custom color</span>
                    </label>
                </div>

                <div data-panel="preset" class="@(Model.ThemeSource == ThemeSource.Custom ? "hidden" : "")">
                    <p class="text-xs font-medium text-muted-foreground mb-2 uppercase tracking-wide">Preset</p>
                    <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
                        @foreach (var p in presets)
                        {
                            var id = $"preset_{p.Key}";
                            <label for="@id" title="@p.Label"
                                   class="flex flex-col items-center gap-1 cursor-pointer rounded-lg border border-transparent p-1.5 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                                <input type="radio" id="@id" name="PresetTheme" value="@p.Key" class="sr-only"
                                       @(string.Equals(Model.PresetTheme, p.Key, StringComparison.Ordinal) ? "checked" : "") />
                                <span class="w-7 h-7 rounded-full @p.Swatch"></span>
                                <span class="text-[10px] text-muted-foreground">@p.Label</span>
                            </label>
                        }
                    </div>
                </div>

                <div data-panel="custom" class="@(Model.ThemeSource == ThemeSource.Custom ? "" : "hidden")">
                    <p class="text-xs font-medium text-muted-foreground mb-2 uppercase tracking-wide">Custom primary color</p>
                    <div class="flex items-center gap-3">
                        <input type="color" name="CustomColorHex" value="@Model.CustomColorHex"
                               class="h-10 w-14 rounded-lg border border-border bg-transparent cursor-pointer"
                               oninput="document.getElementById('hexLabel').textContent = this.value" />
                        <code id="hexLabel" class="text-sm bg-muted px-2 py-1 rounded font-mono">@Model.CustomColorHex</code>
                    </div>
                    <p class="text-xs text-muted-foreground mt-2">Used as the primary/accent color across the UI in both light and dark mode.</p>
                </div>
            </div>
        </div>

        <div class="card-surface p-5">
            <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="ForceMode" value="true" class="form-check mt-1"
                       @(Model.ForceMode ? "checked" : "") data-toggle="mode-options" />
                <span>
                    <span class="font-medium block">Force light / dark mode</span>
                    <span class="text-sm text-muted-foreground">When on, all users get the mode below and the light/dark toggle is hidden.</span>
                </span>
            </label>
            <div id="mode-options" class="mt-4 flex gap-2 @(Model.ForceMode ? "" : "opacity-50 pointer-events-none")">
                <label class="flex-1 flex items-center justify-center gap-2 rounded-lg border border-border p-3 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="Mode" value="@nameof(ThemeModePreference.Light)" class="form-check"
                           @(Model.Mode == ThemeModePreference.Light ? "checked" : "") />
                    <i class="ri-sun-line"></i> <span class="text-sm font-medium">Light</span>
                </label>
                <label class="flex-1 flex items-center justify-center gap-2 rounded-lg border border-border p-3 cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="Mode" value="@nameof(ThemeModePreference.Dark)" class="form-check"
                           @(Model.Mode == ThemeModePreference.Dark ? "checked" : "") />
                    <i class="ri-moon-line"></i> <span class="text-sm font-medium">Dark</span>
                </label>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary"><i class="ri-save-line"></i> Save</button>
            <span class="text-sm text-muted-foreground">Applies on the next page load for all users.</span>
        </div>
    </form>

    <!-- Custom logo -->
    <div class="card-surface p-5">
        <h3 class="font-medium mb-1">Company logo</h3>
        <p class="text-sm text-muted-foreground mb-4">Replace the default logo. SVG, PNG, JPG, WEBP or GIF, up to 2 MB. Optionally add a separate logo for dark mode.</p>

        <!-- Light / default logo -->
        <div class="flex items-center gap-4 mb-3">
            <div class="h-12 px-4 flex items-center rounded-lg bg-white border border-border">
                @if (Model.HasCustomLogo)
                {
                    <img src="@Model.LogoPath" alt="Logo" class="h-8 w-auto object-contain" />
                }
                else
                {
                    <span class="text-xs text-muted-foreground">Default logo</span>
                }
            </div>
            <span class="text-xs text-muted-foreground">@(Model.HasCustomLogo ? "Light mode (also used in dark mode unless overridden below)" : "No custom logo — the default is used")</span>
        </div>

        <form method="post" action="/admin/appearance/logo" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="variant" value="light" />
            <input type="file" name="logo" accept=".svg,.png,.jpg,.jpeg,.webp,.gif"
                   class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-primary file:text-primary-foreground file:px-3 file:py-2 file:text-sm file:font-medium file:cursor-pointer" />
            <button type="submit" class="btn-primary"><i class="ri-upload-2-line"></i> @(Model.HasCustomLogo ? "Replace logo" : "Upload logo")</button>
        </form>

        @if (Model.HasCustomLogo)
        {
            <form method="post" action="/admin/appearance/logo/remove" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="variant" value="light" />
                <button type="submit" class="btn-secondary"><i class="ri-delete-bin-line"></i> Remove custom logo</button>
            </form>

            <!-- Dark-mode logo (only once a light logo exists) -->
            <hr class="my-5 border-border" />
            <h4 class="font-medium mb-1 text-sm">Dark-mode logo <span class="text-xs font-normal text-muted-foreground">(optional)</span></h4>
            <p class="text-sm text-muted-foreground mb-3">Shown when the interface is in dark mode. If not set, the light logo is used in both modes.</p>

            <div class="flex items-center gap-4 mb-3">
                <div class="h-12 px-4 flex items-center rounded-lg bg-gray-900 border border-border">
                    <img src="@Model.EffectiveDarkLogoPath" alt="Dark logo" class="h-8 w-auto object-contain" />
                </div>
                <span class="text-xs text-muted-foreground">@(Model.HasCustomLogoDark ? "Dark mode (custom)" : "Dark mode (falls back to light logo)")</span>
            </div>

            <form method="post" action="/admin/appearance/logo" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="variant" value="dark" />
                <input type="file" name="logo" accept=".svg,.png,.jpg,.jpeg,.webp,.gif"
                       class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-primary file:text-primary-foreground file:px-3 file:py-2 file:text-sm file:font-medium file:cursor-pointer" />
                <button type="submit" class="btn-primary"><i class="ri-upload-2-line"></i> @(Model.HasCustomLogoDark ? "Replace dark logo" : "Upload dark logo")</button>
            </form>

            @if (Model.HasCustomLogoDark)
            {
                <form method="post" action="/admin/appearance/logo/remove" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="variant" value="dark" />
                    <button type="submit" class="btn-secondary"><i class="ri-delete-bin-line"></i> Remove dark logo</button>
                </form>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // Enable/disable the theme + mode option blocks with their master checkbox.
        document.querySelectorAll('[data-toggle]').forEach(function (cb) {
            var panel = document.getElementById(cb.dataset.toggle);
            cb.addEventListener('change', function () {
                panel.classList.toggle('opacity-50', !cb.checked);
                panel.classList.toggle('pointer-events-none', !cb.checked);
            });
        });
        // Switch between preset and custom panels.
        document.querySelectorAll('[data-source]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelector('[data-panel="preset"]').classList.toggle('hidden', radio.dataset.source !== 'preset');
                document.querySelector('[data-panel="custom"]').classList.toggle('hidden', radio.dataset.source !== 'custom');
            });
        });
    </script>
}
