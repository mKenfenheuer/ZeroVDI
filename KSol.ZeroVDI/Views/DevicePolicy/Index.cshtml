@using KSol.ZeroVDI.Models
@model DevicePolicy
@{
    ViewData["Title"] = "Device policy";
    ViewData["Subtitle"] = "Tenant-wide control over which devices and channels console sessions may redirect. Overrides per-user preferences.";

    (string value, string label, string hint)[] modes = new[]
    {
        (nameof(DevicePolicyMode.UserControlled), "User controlled", "Each user decides (default)."),
        (nameof(DevicePolicyMode.Disabled), "Disabled", "Forced off; users cannot enable it."),
        (nameof(DevicePolicyMode.Forced), "Always on", "Forced on; users cannot disable it."),
    };

    (string field, string label, string icon, DevicePolicyMode current)[] features = new[]
    {
        ("Clipboard", "Clipboard sync", "ri-clipboard-line", Model.Clipboard),
        ("Audio", "Remote sound", "ri-volume-up-line", Model.Audio),
        ("Microphone", "Microphone", "ri-mic-line", Model.Microphone),
        ("Camera", "Camera", "ri-camera-line", Model.Camera),
    };
}

<form method="post" class="max-w-2xl space-y-5">
    @Html.AntiForgeryToken()

    @foreach (var f in features)
    {
        <div class="card-surface p-4">
            <div class="flex items-center gap-2 mb-3">
                <i class="@f.icon text-lg text-muted-foreground"></i>
                <h3 class="font-medium">@f.label</h3>
            </div>
            <div class="grid sm:grid-cols-3 gap-2">
                @foreach (var m in modes)
                {
                    var id = $"{f.field}_{m.value}";
                    var isChecked = string.Equals(f.current.ToString(), m.value, StringComparison.Ordinal);
                    <label for="@id" class="flex flex-col gap-0.5 rounded-lg border border-border p-3 cursor-pointer hover:border-primary/50 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                        <span class="flex items-center gap-2 text-sm font-medium">
                            <input type="radio" id="@id" name="@f.field" value="@m.value" checked="@isChecked" class="form-check" />
                            @m.label
                        </span>
                        <span class="text-xs text-muted-foreground pl-6">@m.hint</span>
                    </label>
                }
            </div>
        </div>
    }

    <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary"><i class="ri-save-line"></i> Save policy</button>
        <span class="text-sm text-muted-foreground">Applies to new console sessions immediately.</span>
    </div>
</form>
