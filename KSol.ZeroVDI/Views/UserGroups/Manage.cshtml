@model KSol.ZeroVDI.Models.UserGroup
@using KSol.ZeroVDI.Models
@{
    ViewData["Title"] = $"Group: {Model.Name}";
    ViewData["Subtitle"] = "Members, granted resources, and assigned desktop pools. Every member inherits all of them.";
    var nonMembers = ViewBag.NonMembers as List<ApplicationUser> ?? new();
    var ungranted = ViewBag.UngrantedResources as List<RDPResource> ?? new();
    var assignedPools = ViewBag.AssignedPools as List<VdiPool> ?? new();
    var unassignedPools = ViewBag.UnassignedPools as List<VdiPool> ?? new();
}

@section PageActions {
    <a asp-action="Index" class="btn-secondary w-fit"><i class="ri-arrow-left-line"></i> Back to groups</a>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Group details -->
    <div class="card-surface p-5">
        <h3 class="font-medium mb-3">Group details</h3>
        <form asp-action="Rename" asp-route-id="@Model.Id" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label">Name</label>
                <input name="name" class="form-input" value="@Model.Name" />
            </div>
            <div>
                <label class="form-label">Description</label>
                <input name="description" class="form-input" value="@Model.Description" />
            </div>
            <button type="submit" class="btn-primary btn-sm">Save</button>
        </form>
    </div>

    <!-- Members -->
    <div class="card-surface p-5">
        <h3 class="font-medium mb-3">Members <span class="badge bg-muted text-muted-foreground">@Model.Memberships.Count</span></h3>
        <div class="mb-3">
            @{
                var memberPicker = new AccessPickerModel
                {
                    FormAction = "AddMember",
                    FormController = "UserGroups",
                    RouteId = Model.Id,
                    FieldName = "userId",
                    Placeholder = "Add a user…",
                    ButtonLabel = "Add",
                    Candidates = nonMembers.Select(u => (u.Id, u.UserName ?? u.Id)),
                };
            }
            <partial name="_AccessPicker" model="memberPicker" />
        </div>
        @if (!Model.Memberships.Any())
        {
            <p class="text-sm text-muted-foreground">No members yet.</p>
        }
        else
        {
            <ul class="space-y-1">
            @foreach (var m in Model.Memberships.OrderBy(x => x.User?.UserName))
            {
                <li class="flex items-center justify-between gap-2 text-sm py-1 border-b border-border last:border-0">
                    <span class="min-w-0 truncate">@(m.User?.UserName ?? m.UserId)</span>
                    <form asp-action="RemoveMember" asp-route-id="@Model.Id" method="post" class="inline shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@m.UserId" />
                        <button type="submit" class="text-destructive hover:underline text-xs">Remove</button>
                    </form>
                </li>
            }
            </ul>
        }
    </div>

    <!-- Granted resources -->
    <div class="card-surface p-5">
        <h3 class="font-medium mb-3">Granted resources <span class="badge bg-muted text-muted-foreground">@Model.ResourceAuthorizations.Count</span></h3>
        <div class="mb-3">
            @{
                var resourcePicker = new AccessPickerModel
                {
                    FormAction = "AddResource",
                    FormController = "UserGroups",
                    RouteId = Model.Id,
                    FieldName = "resourceId",
                    Placeholder = "Grant a resource…",
                    ButtonLabel = "Grant",
                    Candidates = ungranted.Select(r => (r.Id, r.Name ?? r.Id)),
                };
            }
            <partial name="_AccessPicker" model="resourcePicker" />
        </div>
        @if (!Model.ResourceAuthorizations.Any())
        {
            <p class="text-sm text-muted-foreground">No resources granted.</p>
        }
        else
        {
            <ul class="space-y-1">
            @foreach (var a in Model.ResourceAuthorizations.OrderBy(x => x.RDPResource?.Name))
            {
                <li class="flex items-center justify-between gap-2 text-sm py-1 border-b border-border last:border-0">
                    <span class="min-w-0 truncate">@(a.RDPResource?.Name ?? a.RDPResourceId)</span>
                    <form asp-action="RemoveResource" asp-route-id="@Model.Id" method="post" class="inline shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="resourceId" value="@a.RDPResourceId" />
                        <button type="submit" class="text-destructive hover:underline text-xs">Revoke</button>
                    </form>
                </li>
            }
            </ul>
        }
    </div>

    <!-- Assigned desktop pools -->
    <div class="card-surface p-5">
        <h3 class="font-medium mb-3">Assigned desktop pools <span class="badge bg-muted text-muted-foreground">@assignedPools.Count</span></h3>
        <div class="mb-3">
            @{
                var poolPicker = new AccessPickerModel
                {
                    FormAction = "AddPool",
                    FormController = "UserGroups",
                    RouteId = Model.Id,
                    FieldName = "poolId",
                    Placeholder = "Assign a desktop pool…",
                    ButtonLabel = "Assign",
                    Candidates = unassignedPools.Select(p => (p.Id, p.Name)),
                };
            }
            <partial name="_AccessPicker" model="poolPicker" />
        </div>
        @if (!assignedPools.Any())
        {
            <p class="text-sm text-muted-foreground">No pools assigned.</p>
        }
        else
        {
            <ul class="space-y-1">
            @foreach (var p in assignedPools)
            {
                <li class="flex items-center justify-between gap-2 text-sm py-1 border-b border-border last:border-0">
                    <a asp-controller="VdiPools" asp-action="Manage" asp-route-id="@p.Id" class="min-w-0 truncate hover:underline">@p.Name</a>
                    <form asp-action="RemovePool" asp-route-id="@Model.Id" method="post" class="inline shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="poolId" value="@p.Id" />
                        <button type="submit" class="text-destructive hover:underline text-xs">Remove</button>
                    </form>
                </li>
            }
            </ul>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/access-picker.js" asp-append-version="true"></script>
}
