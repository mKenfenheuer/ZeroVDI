@model IEnumerable<KSol.ZeroVDI.Models.UserGroup>
@{
    ViewData["Title"] = "Groups";
    ViewData["Subtitle"] = "Assign users to groups and grant whole groups access to resources.";
}

@section PageActions {
    <a asp-action="Create" class="btn-primary w-fit"><i class="ri-add-line"></i> New group</a>
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center text-center py-16 px-4 card-surface border-dashed">
        <div class="w-14 h-14 rounded-full bg-muted flex items-center justify-center mb-4">
            <i class="ri-group-line text-2xl text-muted-foreground"></i>
        </div>
        <h3 class="text-lg font-semibold">No groups yet</h3>
        <p class="text-sm text-muted-foreground mt-1">Create a group to grant several users access at once.</p>
        <a asp-action="Create" class="btn-primary mt-4"><i class="ri-add-line"></i> New group</a>
    </div>
}
else
{
    <table class="table-surface">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Members</th>
                <th>Resources</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td class="font-medium">@g.Name</td>
                <td class="text-muted-foreground">@g.Description</td>
                <td><span class="badge bg-muted text-muted-foreground">@g.Memberships.Count</span></td>
                <td><span class="badge bg-muted text-muted-foreground">@g.ResourceAuthorizations.Count</span></td>
                <td>
                    <div class="flex items-center justify-end gap-2">
                        <a asp-action="Manage" asp-route-id="@g.Id" class="btn-secondary btn-sm">Manage</a>
                        <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="inline"
                              onsubmit="return confirm('Delete group “@g.Name”? Members lose any access granted only through this group.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-outline btn-sm text-destructive border-destructive/40 hover:bg-destructive/10">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
