@model KSol.ZeroVDI.Controllers.DocsViewModel
@{
    ViewData["Title"] = "Documentation";
    ViewData["Subtitle"] = "Administrator guide and reference.";
}

<div class="max-w-4xl mx-auto">
    @if (Model.Breadcrumbs.Count > 1)
    {
        <nav class="flex items-center flex-wrap gap-1 text-sm text-muted-foreground mb-4">
            @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
            {
                var crumb = Model.Breadcrumbs[i];
                if (i > 0)
                {
                    <i class="ri-arrow-right-s-line opacity-50"></i>
                }
                if (i == Model.Breadcrumbs.Count - 1)
                {
                    <span class="text-foreground font-medium">@crumb.Label</span>
                }
                else
                {
                    <a href="@Model.UrlBase/@crumb.Url" class="hover:text-foreground transition-colors">@crumb.Label</a>
                }
            }
        </nav>
    }

    <article class="card-surface p-6 sm:p-8 doc-content">
        @Html.Raw(Model.Html)
    </article>
</div>

@* The contents tree lives in the admin sidebar (DocsNav view component), not on this page. *@

@section Scripts {
    <style>
        /* Scoped typography for rendered markdown. The project's Tailwind build has no typography
           plugin, so documentation prose is styled here against the theme's semantic CSS variables. */
        .doc-content { color: var(--foreground); line-height: 1.7; font-size: 0.95rem; }
        .doc-content > :first-child { margin-top: 0; }
        .doc-content > :last-child { margin-bottom: 0; }
        .doc-content h1 { font-size: 1.875rem; font-weight: 700; line-height: 1.2; margin: 2rem 0 1rem; letter-spacing: -0.02em; }
        .doc-content h2 { font-size: 1.4rem; font-weight: 600; margin: 2rem 0 0.85rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
        .doc-content h3 { font-size: 1.15rem; font-weight: 600; margin: 1.6rem 0 0.6rem; }
        .doc-content h4 { font-size: 1rem; font-weight: 600; margin: 1.3rem 0 0.5rem; }
        .doc-content p { margin: 0.85rem 0; }
        .doc-content a { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; }
        .doc-content a:hover { opacity: 0.8; }
        .doc-content ul, .doc-content ol { margin: 0.85rem 0; padding-left: 1.5rem; }
        .doc-content ul { list-style: disc; }
        .doc-content ol { list-style: decimal; }
        .doc-content li { margin: 0.3rem 0; }
        .doc-content li > ul, .doc-content li > ol { margin: 0.3rem 0; }
        .doc-content blockquote { border-left: 3px solid var(--border); padding: 0.25rem 1rem; margin: 1rem 0; color: var(--muted-foreground); background: var(--muted); border-radius: 0 var(--radius) var(--radius) 0; }
        .doc-content code { font-family: var(--font-mono); font-size: 0.85em; background: var(--muted); padding: 0.15em 0.4em; border-radius: 0.35rem; }
        .doc-content pre { background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; overflow-x: auto; margin: 1rem 0; }
        .doc-content pre code { background: none; padding: 0; font-size: 0.85rem; line-height: 1.5; }
        .doc-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; display: block; overflow-x: auto; }
        .doc-content th, .doc-content td { border: 1px solid var(--border); padding: 0.55rem 0.85rem; text-align: left; }
        .doc-content th { background: var(--muted); font-weight: 600; }
        .doc-content hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
        .doc-content img { max-width: 100%; border-radius: var(--radius); margin: 1rem 0; }
        .doc-content h1 a, .doc-content h2 a, .doc-content h3 a, .doc-content h4 a { color: inherit; text-decoration: none; }
        .doc-content .contains-task-list { list-style: none; padding-left: 0.25rem; }
        .doc-content .task-list-item { display: flex; align-items: baseline; gap: 0.5rem; }
    </style>
}
