@model KSol.ZeroVDI.Models.ProxmoxBackend

<div>
    <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">Connection</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" placeholder="Lab cluster" />
            <span asp-validation-for="Name" class="form-error"></span>
        </div>
        <div>
            <label asp-for="Host" class="form-label"></label>
            <input asp-for="Host" class="form-input" placeholder="https://pve.example.com:8006" />
            <span asp-validation-for="Host" class="form-error"></span>
        </div>
        <div>
            <label asp-for="ApiTokenId" class="form-label"></label>
            <input asp-for="ApiTokenId" class="form-input" placeholder="user@pve!gateway" />
            <span asp-validation-for="ApiTokenId" class="form-error"></span>
        </div>
        <div>
            <label asp-for="ApiTokenSecret" class="form-label"></label>
            <input asp-for="ApiTokenSecret" class="form-input" type="password" autocomplete="new-password"
                   placeholder="@(string.IsNullOrEmpty(Model.ApiTokenSecret) ? "" : "•••••••• (leave blank to keep)")" />
            <span asp-validation-for="ApiTokenSecret" class="form-error"></span>
        </div>
        <label class="md:col-span-2 flex items-center gap-2 text-sm cursor-pointer">
            <input asp-for="VerifyTls" class="form-check" />
            <span>@Html.DisplayNameFor(m => m.VerifyTls)</span>
        </label>
        <p class="md:col-span-2 text-xs text-muted-foreground -mt-2">Keep this on: the API token that manages every VM travels over this connection. Turn it off only for a self-signed lab cluster.</p>
        @if (ViewBag.Connectors is List<KSol.ZeroVDI.Models.Connector> connectors && connectors.Count > 0)
        {
            <div class="md:col-span-2">
                <label asp-for="ConnectorId" class="form-label"></label>
                <select asp-for="ConnectorId" class="form-input">
                    <option value="">Direct (no connector)</option>
                    @foreach (var c in connectors)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <p class="text-xs text-muted-foreground mt-1">Tunnel the Proxmox API through a connector when this cluster is not directly reachable.</p>
            </div>
        }
    </div>
</div>

<div>
    <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">Desktop sign-in (NLA) — optional Kerberos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label asp-for="KerberosRealm" class="form-label"></label>
            <input asp-for="KerberosRealm" class="form-input" placeholder="CORP.EXAMPLE.COM" />
        </div>
        <div>
            <label asp-for="KdcHost" class="form-label"></label>
            <input asp-for="KdcHost" class="form-input" placeholder="dc1.corp.example.com[:88]" />
        </div>
    </div>
    <p class="text-xs text-muted-foreground mt-1">For the VMs on this backend. Leave empty for workgroup VMs (NTLMv2 is used). Kerberos for NLA is prepared but not yet active in the console; these values are stored for when it is.</p>
</div>

<div>
    <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-3">VDI lifecycle policy</h2>
    <label class="flex items-center gap-2 text-sm cursor-pointer mb-4">
        <input asp-for="IdleReapEnabled" class="form-check" />
        <span>@Html.DisplayNameFor(m => m.IdleReapEnabled)</span>
    </label>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
            <label asp-for="DefaultRdpPort" class="form-label"></label>
            <input asp-for="DefaultRdpPort" class="form-input" type="number" />
        </div>
        <div>
            <label asp-for="IdleTimeoutHours" class="form-label"></label>
            <input asp-for="IdleTimeoutHours" class="form-input" type="number" />
        </div>
        <div>
            <label asp-for="PauseAction" class="form-label"></label>
            <select asp-for="PauseAction" class="form-select"
                    asp-items="Html.GetEnumSelectList<KSol.ZeroVDI.Models.PauseAction>()"></select>
        </div>
        <div>
            <label asp-for="StartTimeoutSeconds" class="form-label"></label>
            <input asp-for="StartTimeoutSeconds" class="form-input" type="number" />
        </div>
    </div>
</div>
