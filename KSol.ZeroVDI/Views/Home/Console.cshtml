@using KSol.ZeroVDI.Models
@{
    Layout = null;
    var resourceId = ViewData["ResourceId"] as string;
    var resourceName = ViewData["ResourceName"] as string;
    var autoConnect = ViewData["AutoConnect"] is true;
    // SSO auto-connect never receives the real stored credentials (the gateway injects them
    // server-side). The browser uses harmless placeholders purely so the form submits and the inner
    // handshake frames are well-formed; client.js suppresses the credentials WS frame when AutoConnect
    // is set, and the gateway's MITM replaces any inner Client Info creds with the stored ones.
    var storedUser = autoConnect ? "sso" : "";
    var storedPassword = autoConnect ? "sso" : "";
    var storedDomain = "";
    // SPICE (bridged) connections auth via the Proxmox spiceproxy ticket (fetched server-side with an
    // API token) — the VM username/password/domain are meaningless, so hide those inputs. The login
    // overlay still shows (so the Session options panel stays reachable); the user just clicks Connect.
    // Fall back to a fresh ConnectionDefaults so the model's defaults (all session + visual options on)
    // drive the popup when this (user, resource) has nothing stored yet.
    var defaults = ViewData["Defaults"] as ConnectionDefaults ?? new ConnectionDefaults();
    var recordingNotice = ViewData["RecordingNotice"] is true;

    // Admin-enforced device policy: clamp the starting values and lock the corresponding checkboxes so a
    // disabled feature can't be (re-)enabled here. The relay clamps too, so this is purely UX.
    var devicePolicy = ViewData["DevicePolicy"] as DevicePolicy ?? new DevicePolicy();
    defaults = new ConnectionDefaults
    {
        Audio = DevicePolicy.Clamp(devicePolicy.Audio, defaults.Audio),
        Clipboard = DevicePolicy.Clamp(devicePolicy.Clipboard, defaults.Clipboard),
        Microphone = DevicePolicy.Clamp(devicePolicy.Microphone, defaults.Microphone),
        Camera = DevicePolicy.Clamp(devicePolicy.Camera, defaults.Camera),
        GfxMode = defaults.GfxMode,
        PerformanceFlags = defaults.PerformanceFlags,
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@resourceName — RDP Console</title>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    @* The redesigned overlays (preflight, login, reconnect, clipboard) use the Tailwind design system.
       Share the app's <head> assets + pre-paint theme script via _ThemeHead so the console honors the
       admin's forced theme/mode AND the tenant's custom brand color (emitted as inline CSS overrides) —
       exactly like the rest of the app, rather than the bespoke localStorage-only script this used to
       carry (which never injected the custom color). *@
    @await Html.PartialAsync("_ThemeHead")
    <style>
        html, body { height: 100%; margin: 0; background: #1a1a1a; color: #eee; overflow: hidden; }

        /* Floating session control bar: auto-minimizes to a slim pill at the top center and
           auto-hides while you work; hovering the top edge (or moving the mouse) reveals it. */
        #floatbar {
            position: fixed; top: 8px; left: 50%; transform: translateX(-50%);
            z-index: 40; display: flex; align-items: center; gap: .4rem;
            padding: .25rem .4rem; border-radius: 999px;
            background: rgba(28,28,30,.92); border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 4px 18px rgba(0,0,0,.45); backdrop-filter: blur(6px);
            font-size: .82rem; transition: opacity .25s ease, transform .25s ease;
            max-width: 92vw;
        }
        /* Auto-hidden: slides up out of view and ignores pointer events until revealed. */
        #floatbar.hidden { opacity: 0; transform: translateX(-50%) translateY(-130%); pointer-events: none; }
        /* Minimized: collapses to just the grip + name + status; the controls are hidden. */
        #floatbar.min #floatbar-controls { display: none; }
        #floatbar .grip {
            cursor: pointer; padding: 0 .35rem; color: #9aa0a6; user-select: none; font-size: 1rem;
            line-height: 1;
        }
        #floatbar .name { font-weight: 600; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; max-width: 22vw; margin-left: 10px }
        #floatbar .status { color: #9bd; white-space: nowrap; }
        /* Connection-quality indicator: a phone-style signal-bars glyph (4 ascending bars) derived from
           the END-TO-END RTT (browser↔gateway measured in quality-worker.js + gateway↔host sampled by
           the relay) and gateway-side throughput (see client.js setQualityCallback). Hidden until the
           first sample arrives. Lit bars (within the current quality level) render at full opacity in the
           level's color; unlit bars stay a dim neutral fill at 75% opacity, same as a phone's signal icon. */
        #floatbar .quality { display: none; align-items: center; gap: .35rem; white-space: nowrap; color: #9aa0a6; }
        #floatbar .quality.show { display: flex; }
        #floatbar .quality-bars { display: flex; align-items: flex-end; gap: 1px; height: .6rem; }
        #floatbar .quality-bars i {
            display: block; width: 3px; background: #777; opacity: .75; border-radius: 1px;
        }
        #floatbar .quality-bars i:nth-child(1) { height: 25%; }
        #floatbar .quality-bars i:nth-child(2) { height: 50%; }
        #floatbar .quality-bars i:nth-child(3) { height: 75%; }
        #floatbar .quality-bars i:nth-child(4) { height: 100%; }
        #floatbar .quality-bars i.lit { opacity: 1; }
        #floatbar .quality.good .quality-bars i.lit { background: #3ecf6a; }
        #floatbar .quality.fair .quality-bars i.lit { background: #e0a52c; }
        #floatbar .quality.poor .quality-bars i.lit { background: #e0453c; }
        #floatbar-controls { display: flex; align-items: center; gap: .35rem; }
        #floatbar .btn { --bs-btn-padding-y: .15rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .78rem; }
        /* A thin invisible strip along the top edge to reveal the bar when it's auto-hidden. */
        #reveal-zone { position: fixed; top: 0; left: 30%; right: 30%; height: 5px; z-index: 39; }
        #screen-wrap {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            overflow: hidden; display: flex; align-items: center; justify-content: center;
            background: #000;
        }
        /* CSS size is set per-connection by client._fit() so the device-pixel backing store maps 1:1
           on HiDPI displays (crisp, no browser upscaling). */
        #canvas { background: #000; display: block; }
        #pointer-cache { display: none; }
        /* The remote pointer is applied by client.js to #screen-wrap (the whole console area,
           including the black letterbox around the canvas); `cursor` inherits down to the
           canvas. Overlays/dialogs are siblings of #screen-wrap and keep their own cursors. */
        html, body {
            scrollbar-width: none; /* Instantly deletes the 15px invisible barrier in Firefox */
        }
        .pointer-cache-null { cursor: none; }
        .pointer-cache-default { cursor: default; }
        /* Preflight overlay: the readiness flow (start VM, wait for guest agent / IP / RDP) shown before
           the login form or auto-connect. Ensures even a direct link to the console runs the start
           process. Uses the Tailwind design system (see markup for classes). */
        #preflight-overlay {
            position: fixed; inset: 0; z-index: 33; display: flex; align-items: center; justify-content: center;
            background: rgba(0,0,0,.85);
        }
        #preflight-overlay.hidden { display: none !important; }

        /* Animated connection icon at the top of the preflight popup: a remote-control glyph with two
           concentric "signal" rings that pulse outward, conveying an in-progress connection attempt.
           Switches to a steady error tint when the flow fails (.failed on the wrapper). */
        #pf-icon {
            position: relative; width: 4.5rem; height: 4.5rem; display: flex;
            align-items: center; justify-content: center; flex-shrink: 0;
        }
        #pf-icon .pf-icon-core {
            position: relative; z-index: 2; width: 3rem; height: 3rem; border-radius: 9999px;
            display: flex; align-items: center; justify-content: center;
            background: var(--color-primary); color: var(--color-primary-foreground);
            box-shadow: 0 4px 14px rgba(0,0,0,.18);
        }
        #pf-icon .pf-icon-core i { font-size: 1.5rem; animation: pf-bob 1.8s ease-in-out infinite; }
        #pf-icon .pf-ring {
            position: absolute; inset: 0; border-radius: 9999px; z-index: 1;
            border: 2px solid var(--color-primary);
            animation: pf-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        #pf-icon .pf-ring.pf-ring-2 { animation-delay: .9s; }
        @@keyframes pf-ping {
            0%   { transform: scale(.55); opacity: .7; }
            80%, 100% { transform: scale(1); opacity: 0; }
        }
        @@keyframes pf-bob {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-2px); }
        }
        /* Progress bar: animated pulse sweeping left-to-right in the direction of progress.
           Set the fill colour from the theme variable directly: Bootstrap (loaded on this page) also
           defines a .bg-primary utility with !important that would otherwise force its own blue, so we
           can't rely on the Tailwind bg-primary class here. Matches the #pf-icon core colour. */
        #pf-progress-bar {
            position: relative;
            overflow: hidden;
            background-color: var(--color-primary);
        }
        #pf-progress-bar::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--color-primary-foreground) 35%, transparent) 50%, transparent 100%);
            transform: translateX(-100%);
            animation: pf-bar-sweep 1.4s ease-in-out infinite;
        }
        #pf-progress-bar.done::after { animation: none; opacity: 0; }
        @@keyframes pf-bar-sweep {
            0%   { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        /* Failed state: stop the pulsing, tint everything with the destructive colour. */
        #pf-icon.failed .pf-icon-core { background: var(--color-destructive); }
        #pf-icon.failed .pf-icon-core i { animation: none; }
        #pf-icon.failed .pf-ring { animation: none; opacity: 0; }
        @@media (prefers-reduced-motion: reduce) {
            #pf-icon .pf-icon-core i, #pf-icon .pf-ring { animation: none; }
            #pf-icon .pf-ring { opacity: .25; transform: scale(.85); }
            #pf-progress-bar::after { animation: none; opacity: 0; }
        }

        #login-overlay {
            position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center;
            background: rgba(0,0,0,.85);
        }
        /* Auto-connect / SSO sessions never show the login form: it's hidden outright so the page goes
           straight to connecting. */
        #login-overlay.hidden { display: none !important; }

        /* Reconnect popup: a small centered card shown when an auto-connect (SSO) session drops, instead
           of bringing back the full login form. One button re-establishes the session. */
        #reconnect-overlay {
            position: fixed; inset: 0; z-index: 32; display: none; align-items: center; justify-content: center;
            background: rgba(0,0,0,.85);
        }
        #reconnect-overlay.show { display: flex; }

        /* Reconnecting banner: shown on a NETWORK/PROTOCOL drop (WebSocket died, ungraceful close) — as
           opposed to the graceful reconnect-overlay above. Deliberately a small, non-opaque centered card
           so the last rendered desktop frame stays visible behind it while we count down + auto-retry. */
        #reconnecting-overlay {
            position: fixed; inset: 0; z-index: 33; display: none;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,.35); pointer-events: none;
        }
        #reconnecting-overlay.show { display: flex; }
        #reconnecting-card { pointer-events: auto; }
        #reconnecting-spinner {
            width: 2.5rem; height: 2.5rem; border-radius: 50%;
            border: 3px solid rgba(255,255,255,.18); border-top-color: var(--primary, #3b82f6);
            animation: reconnect-spin .9s linear infinite;
        }
        @@keyframes reconnect-spin { to { transform: rotate(360deg); } }
        .btn-session-control {
            appearance: none;
            background: transparent;
            border: none;
            color: #fff;
            padding: 6px 10px;
            cursor: pointer;
            border-radius: 1rem;
            transition: background-color 0.2s ease;
        }

        .btn-session-control:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .fa-red {
            color: #f00;
        }

        /* Recording indicator: a 5px red frame around the whole session and a dismissible banner.
           Both are only rendered when the recording rule asks to notify the user. The frame sits above
           the canvas but ignores pointer events so it never intercepts clicks meant for the desktop. */
        #rec-frame {
            position: fixed; inset: 0; z-index: 35; pointer-events: none;
            border: 5px solid #e3342f; box-sizing: border-box;
        }
        #rec-banner {
            position: fixed; top: 8px; left: 50%; transform: translateX(-50%);
            z-index: 50; display: flex; align-items: center; gap: .55rem;
            padding: .4rem .65rem .4rem .8rem; border-radius: 999px;
            background: rgba(227,52,47,.95); color: #fff; font-size: .82rem; font-weight: 600;
            box-shadow: 0 4px 18px rgba(0,0,0,.45);
            transition: opacity .3s ease, transform .3s ease;
        }
        #rec-banner.hidden { opacity: 0; transform: translateX(-50%) translateY(-130%); pointer-events: none; }
        #rec-banner .rec-dot {
            width: .6rem; height: .6rem; border-radius: 50%; background: #fff;
            animation: rec-blink 1.4s ease-in-out infinite;
        }
        @@keyframes rec-blink { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
        #rec-banner .rec-close {
            appearance: none; background: transparent; border: none; color: #fff;
            cursor: pointer; padding: 0 .15rem; font-size: .9rem; line-height: 1; opacity: .85;
        }
        #rec-banner .rec-close:hover { opacity: 1; }

        /* Clipboard overlay: a small popup panel holding a textarea kept in sync with the remote
           session's clipboard. Browser clipboard autosync is unfeasible (gesture + permission per
           read), so the user edits this box and pushes its contents to the remote on demand; text the
           remote copies is shown here. Centered modal-style panel dimmed over the session. */
        #clip-overlay {
            position: fixed; inset: 0; z-index: 45; display: none;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,.55);
        }
        #clip-overlay.show { display: flex; }
        #clip-card { width: 520px; max-width: 92vw; }
        #clip-text {
            width: 100%; min-height: 180px; resize: vertical;
            font-family: var(--font-mono, monospace); font-size: .85rem;
        }
        #clip-actions { display: flex; align-items: center; gap: .5rem; margin-top: .65rem; }
        #clip-actions .clip-hint { font-size: .74rem; margin-left: auto; min-height: 1em; }
    </style>
</head>
<body>
    @if (recordingNotice)
    {
        @* Recording disclosure — shown only when the matched recording rule has NotifyUser=true. The red
           frame and banner appear once the session is connected (see the "ready" status handler). *@
        <div id="rec-frame" style="display:none;"></div>
        <div id="rec-banner" class="hidden">
            <span class="rec-dot"></span>
            <span>This session is being recorded</span>
            <button type="button" class="rec-close" id="rec-banner-close" title="Dismiss">&times;</button>
        </div>
    }
    @* Preflight overlay — the readiness flow (start/resume the VM, wait for guest agent, IP, RDP probe).
       Runs on page load BEFORE the login form / auto-connect, so even a direct link to the console kicks
       off the start process. On success it hands over to the login overlay (or auto-connect). *@
    <div id="preflight-overlay">
        <div class="card-surface p-6 w-[26rem] max-w-[90vw]">
            <div class="flex flex-col items-center text-center mb-5">
                <div id="pf-icon" class="mb-3">
                    <span class="pf-ring"></span>
                    <span class="pf-ring pf-ring-2"></span>
                    <span class="pf-icon-core"><i class="ri-remote-control-line"></i></span>
                </div>
                <h1 class="text-base font-semibold truncate max-w-full">@resourceName</h1>
                <p id="pf-message" class="text-sm text-muted-foreground">Checking resource…</p>
            </div>

            <div class="mb-2">
                <div class="flex items-center gap-2 mb-2 text-sm font-medium text-foreground">
                    <span id="pf-step-label">Checking resource…</span>
                </div>
                <div class="h-2 rounded-full bg-muted ring-1 ring-border/50 overflow-hidden">
                    <div id="pf-progress-bar" class="h-full rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
                </div>
                <p id="pf-step-counter" class="mt-1.5 text-xs text-muted-foreground"></p>
            </div>

            <div id="pf-error" class="alert-error mt-4 hidden">
                <i class="ri-error-warning-line text-destructive text-lg"></i>
                <div class="text-sm flex-1">
                    <p id="pf-error-text" class="font-medium"></p>
                    <p class="text-muted-foreground mt-0.5">If this keeps happening, contact an administrator.</p>
                </div>
            </div>

            <div id="pf-actions" class="flex items-center gap-2 mt-4 hidden">
                <button id="pf-retry" type="button" class="btn-primary"><i class="ri-refresh-line"></i> Try again</button>
                <a asp-controller="Home" asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </div>
    </div>

    <div id="reveal-zone"></div>
    <div id="floatbar" class="hidden">
        <span class="name">@resourceName</span>
        <span class="quality" id="floatbar-quality" title="Connection quality">
            <span class="quality-bars"><i></i><i></i><i></i><i></i></span>
            <span id="floatbar-quality-label"></span>
        </span>
        <span id="floatbar-controls">
            <button class="btn-session-control" id="btn-clip" type="button"
                    title="Clipboard — sync text with the remote session"><i class="fa-solid fa-clipboard"></i></button>
            <button class="btn-session-control" id="btn-cad" type="button"
                    title="Send Ctrl+Alt+Del to the remote session"><i class="fa-solid fa-keyboard"></i></button>
            <button class="btn-session-control" id="btn-fullscreen" type="button"><i class="fa-solid fa-expand"></i></button>
            <button class="btn-session-control" id="btn-mute" type="button" actiontitle="Mute / unmute remote sound"><i class="fa-solid fa-volume"></i></button>
            <button class="btn-session-control fa-red" id="btn-disable-video" type="button"><i class="fa-solid fa-video-slash"></i></button>
            <button class="btn-session-control fa-red" id="btn-disable-microphone" type="button"><i class="fa-solid fa-microphone-slash"></i></button>
            <button class="btn-session-control fa-red" id="btn-disconnect" type="button" disabled><i class="fa-solid fa-link-slash"></i></button>
        </span>
    </div>

    <div id="screen-wrap">
        <canvas id="canvas" width="1280" height="800"></canvas>
        <canvas id="pointer-cache" width="32" height="32"></canvas>
    </div>

    @* Clipboard overlay — manual text sync with the remote session (see #clip-overlay styles). Toggled
       by the floatbar clipboard button. The textarea shows text the remote copied and is the source for
       "Send to remote". *@
    <div id="clip-overlay">
        <div id="clip-card" class="card-surface p-5">
            <h6 class="text-base font-semibold mb-1">Clipboard</h6>
            <div class="text-xs text-muted-foreground mb-3">Edit the text and send it to the remote session, or copy text the
                remote put on its clipboard from here.</div>
            <textarea id="clip-text" class="form-input" placeholder="Type or paste text here, then “Send to remote”…"></textarea>
            <div id="clip-actions">
                <button class="btn-primary" type="button" id="clip-send">Send to remote</button>
                <button class="btn-secondary" type="button" id="clip-copy">Copy</button>
                <button class="btn-ghost" type="button" id="clip-close">Close</button>
                <span class="clip-hint text-success" id="clip-hint"></span>
            </div>
        </div>
    </div>

    @* Reconnect popup — shown when an auto-connect (SSO) session drops. The full login form is hidden
       for SSO sessions, so instead of re-rendering it on disconnect we offer a single Reconnect button. *@
    <div id="reconnect-overlay">
        <div id="reconnect-card" class="card-surface p-6 w-80 max-w-[90vw] text-center">
            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-3">
                <i class="ri-link-unlink text-2xl"></i>
            </div>
            <h5 class="text-base font-semibold mb-1">Session disconnected</h5>
            <div id="reconnect-msg" class="text-sm text-muted-foreground min-h-[1.2em] mb-4"></div>
            <button class="btn-primary w-full justify-center" type="button" id="btn-reconnect"><i class="ri-refresh-line"></i> Reconnect</button>
        </div>
    </div>

    @* Reconnecting banner — shown on a network/protocol drop (not a graceful host disconnect). The last
       desktop frame stays visible behind this card. A countdown runs to a "connection is dead" deadline;
       we auto-retry every 15s until then. The user can force a retry now or give up. *@
    <div id="reconnecting-overlay">
        <div id="reconnecting-card" class="card-surface p-6 w-80 max-w-[90vw] text-center">
            <div id="reconnecting-spinner" class="mx-auto mb-3"></div>
            <h5 class="text-base font-semibold mb-1">Trying to reconnect…</h5>
            <div class="text-sm text-muted-foreground min-h-[1.2em] mb-1">Connection lost. Attempting to restore your session.</div>
            <div id="reconnecting-countdown" class="text-sm text-muted-foreground mb-4">Giving up in <span id="reconnecting-secs">--</span>s</div>
            <div class="flex gap-2">
                <button class="btn-primary flex-1 justify-center" type="button" id="btn-retry-now"><i class="ri-refresh-line"></i> Retry now</button>
                <button class="btn-secondary flex-1 justify-center" type="button" id="btn-give-up"><i class="ri-close-line"></i> Cancel</button>
            </div>
        </div>
    </div>

    @* Hidden on load: the preflight overlay runs first and reveals this (manual sessions) or triggers
       auto-connect (SSO) once the resource is ready. *@
    <div id="login-overlay" class="hidden">
        <div id="login-card" class="card-surface p-6 w-[26rem] max-w-[90vw] max-h-[90vh] overflow-y-auto">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                    <i class="ri-computer-line text-2xl"></i>
                </div>
                <h5 class="text-base font-semibold truncate">Connect to @resourceName</h5>
            </div>
            <form id="login-form" autocomplete="off" class="space-y-3">
                <div>
                    <label for="vm-user" class="form-label">Username</label>
                    <input class="form-input" id="vm-user" value="@storedUser" autocomplete="username" />
                </div>
                <div>
                    <label for="vm-pass" class="form-label">Password</label>
                    <input class="form-input" id="vm-pass" type="password" value="@storedPassword" autocomplete="current-password" />
                </div>
                <div>
                    <label for="vm-domain" class="form-label">Domain <span class="text-muted-foreground font-normal">(optional)</span></label>
                    <input class="form-input" id="vm-domain" value="@storedDomain" />
                </div>

                <details class="rounded-lg border border-border">
                    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium text-foreground">Session options</summary>
                    <div class="px-3 pb-3">
                        @* The single shared option editor (Views/Shared/_ConnectionDefaultsEditor.cshtml),
                           rendered in "console" mode: it emits the ids the connect handler reads
                           (opt-audio, opt-gfx-mode, …) and the named-key perf checkboxes, and reflects the
                           user's/admin's pre-saved values — checked states come from `defaults`, never
                           hardcoded. Passing DevicePolicy drives the per-feature admin locks. *@
                        @{
                            var consoleVd = new ViewDataDictionary(ViewData)
                            {
                                ["Mode"] = "console",
                                ["DevicePolicy"] = devicePolicy,
                            };
                        }
                        <partial name="_ConnectionDefaultsEditor" model="defaults" view-data="consoleVd" />
                    </div>
                </details>

                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input class="form-check" type="checkbox" id="opt-store-creds" />
                    <span>Store credentials for next time</span>
                </label>
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input class="form-check" type="checkbox" id="opt-remember-settings" />
                    <span>Remember these settings</span>
                </label>

                <div id="login-error" class="text-sm text-destructive min-h-[1.2em]"></div>
                <button class="btn-primary w-full justify-center" type="submit" id="btn-connect">Connect</button>
                <p class="text-xs text-muted-foreground mt-1 mb-0">
                    Credentials authenticate the desktop (NLA) over this HTTPS connection. When “Store credentials”
                    is checked they are saved encrypted to your account for one-click reconnect.
                </p>
            </form>
        </div>
    </div>

    @* The RLE wasm module auto-initializes on load and exposes a global `Module`. *@
    <script>
        // locateFile lets the emscripten loader find the .wasm next to the .js under /lib/rdpweb/rle/.
        var Module = { locateFile: function (p) { return "/lib/rdpweb/rle/" + p; } };
    </script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>

    @* asp-append-version stamps a content hash onto each src (?v=…) so a changed file is always
       refetched — browsers cache these static JS aggressively, which silently served stale code while
       iterating on the camera channel. *@
    <script src="~/lib/rdpweb/rle/ms-rle-wasm.js" asp-append-version="true"></script>

    <script src="~/lib/rdpweb/binary.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/color.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/header.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/bitmap.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/update/pointer.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/header.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/keymap.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/keyboard.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/input/mouse.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpsnd.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/audin.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpecam.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/cliprdr.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/zgfx.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/mppc.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/clear.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/progressive.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/rdpgfx.js" asp-append-version="true"></script>
    <script src="~/lib/rdpweb/protocol.js" asp-append-version="true"></script>
