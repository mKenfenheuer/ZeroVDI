    <script>
        // SSO auto-connect: when the gateway has stored credentials + defaults for this (user,
        // resource), it renders these so the page connects on load without the login overlay. The
        // gateway also has the credentials for NLA, so client.js must NOT send a credentials frame.
        window.RDP_AUTOCONNECT = @(autoConnect ? "true" : "false");
        window.RDP_DEFAULT_PERF = @(defaults?.PerformanceFlags ?? 0);
        window.RDP_DEFAULT_HIDPI = @((defaults?.HiDpi ?? false) ? "true" : "false");
        window.RDP_RESOURCE_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(resourceId));
    </script>
    <script>
        (function () {
            var wsUrl = "/ws/rdp/@resourceId";
            var preflightOverlay = document.getElementById("preflight-overlay");
            var loginOverlay = document.getElementById("login-overlay");
            var loginError = document.getElementById("login-error");
            var reconnectOverlay = document.getElementById("reconnect-overlay");
            var reconnectMsg = document.getElementById("reconnect-msg");
            var btnReconnect = document.getElementById("btn-reconnect");
            var reconnectingOverlay = document.getElementById("reconnecting-overlay");
            var reconnectingSecs = document.getElementById("reconnecting-secs");
            var btnRetryNow = document.getElementById("btn-retry-now");
            var btnGiveUp = document.getElementById("btn-give-up");
            var btnConnect = document.getElementById("btn-connect");
            var btnDisconnect = document.getElementById("btn-disconnect");
            var btnCad = document.getElementById("btn-cad");
            var btnFullscreen = document.getElementById("btn-fullscreen");
            var btnMute = document.getElementById("btn-mute");
            var btnDisableMic = document.getElementById("btn-disable-microphone");
            var btnDisableVideo = document.getElementById("btn-disable-video");
            var btnClip = document.getElementById("btn-clip");
            var clipOverlay = document.getElementById("clip-overlay");
            var clipText = document.getElementById("clip-text");
            var clipHint = document.getElementById("clip-hint");
            var btnClipSend = document.getElementById("clip-send");
            var btnClipCopy = document.getElementById("clip-copy");
            var btnClipClose = document.getElementById("clip-close");
            var floatbar = document.getElementById("floatbar");
            var revealZone = document.getElementById("reveal-zone");

            // ---- recording disclosure -----------------------------------------------------------------
            // Present only when the recording rule asked to notify (server-rendered #rec-frame/#rec-banner).
            // On connect: show the red frame + banner; auto-hide the banner after 30s (frame stays for the
            // whole session). The close button dismisses the banner early. Both hide when the session ends.
            var recFrame = document.getElementById("rec-frame");
            var recBanner = document.getElementById("rec-banner");
            var recBannerTimer = null;
            function showRecording() {
                if (!recFrame) return;
                recFrame.style.display = "block";
                recBanner.classList.remove("hidden");
                if (recBannerTimer) clearTimeout(recBannerTimer);
                recBannerTimer = setTimeout(function () { recBanner.classList.add("hidden"); }, 30000);
            }
            function hideRecording() {
                if (!recFrame) return;
                if (recBannerTimer) clearTimeout(recBannerTimer);
                recFrame.style.display = "none";
                recBanner.classList.add("hidden");
            }
            if (recBanner) {
                document.getElementById("rec-banner-close").addEventListener("click", function () {
                    if (recBannerTimer) clearTimeout(recBannerTimer);
                    recBanner.classList.add("hidden");
                });
            }

            var screenWrap = document.getElementById("screen-wrap");
            var canvas = document.getElementById("canvas");
            var client = new Client(wsUrl, "canvas");

            // Return the console to its pre-connect state: blank the screen and bring back a way to
            // reconnect. For an SSO/auto-connect session the login form stays hidden — we show the small
            // centered Reconnect popup instead. For a manual session we re-show the login form.
            function resetConsole(message) {
                stopReconnecting(); // clear any active reconnect loop before returning to the reset UI
                var ctx = canvas.getContext("2d");
                if (ctx) { ctx.fillStyle = "#000"; ctx.fillRect(0, 0, canvas.width, canvas.height); }
                btnDisconnect.disabled = true;
                btnConnect.disabled = false;
                btnConnect.textContent = "Connect";
                if (hideTimer) clearTimeout(hideTimer);
                floatbar.classList.add("hidden");
                hideRecording();
                clipOverlay.classList.remove("show"); // hide the clipboard popup when the session ends
                if (window.RDP_AUTOCONNECT) {
                    reconnectMsg.textContent = message || "";
                    reconnectOverlay.classList.add("show");
                } else {
                    loginError.textContent = message || "";
                    loginOverlay.classList.remove("hidden");
                    loginOverlay.style.display = "flex";
                }
            }

            // ---- auto-reconnect on network/protocol drop ----------------------------------------------
            // A drop (WebSocket died, ungraceful close) surfaces as the client's "reconnecting" status —
            // distinct from a graceful host disconnect ("closed"). We keep the last desktop frame on the
            // canvas, show a countdown to a hard deadline, and re-attempt connect() every RETRY_EVERY ms
            // until either the session comes back ("ready" cancels us) or the deadline passes (declare the
            // connection dead → fall back to the normal reset/login flow).
            var RECONNECT_DEADLINE_MS = 120000; // give up after 2 min of no successful reconnect
            var RETRY_EVERY_MS = 15000;
            var lastCreds = null;               // creds from the most recent connect(), replayed on retry
            var reconnectDeadline = 0;          // performance.now() timestamp when we declare it dead
            var reconnectTickTimer = null;      // 1s countdown UI tick
            var reconnectRetryTimer = null;     // 15s interval firing each connect() retry attempt
            var reconnectActive = false;

            function clearReconnectTimers() {
                if (reconnectTickTimer) { clearInterval(reconnectTickTimer); reconnectTickTimer = null; }
                if (reconnectRetryTimer) { clearInterval(reconnectRetryTimer); reconnectRetryTimer = null; }
            }

            // Fully exit the reconnect state (session restored, gave up, or user cancelled).
            function stopReconnecting() {
                reconnectActive = false;
                clearReconnectTimers();
                reconnectingOverlay.classList.remove("show");
            }

            // Fire one reconnect attempt: re-size the canvas to the current viewport (it may have changed)
            // and re-drive connect() with the same credentials. A failed attempt re-enters "reconnecting"
            // (client emits it again on the socket close), which is harmless — the loop keeps its deadline.
            function attemptReconnect() {
                if (!reconnectActive || !lastCreds) return;
                // Re-size ONLY when the viewport actually changed. Assigning canvas.width/height (which
                // applyDesktopSize does unconditionally) resets the canvas bitmap to blank — that would
                // wipe the last frame we're deliberately keeping on screen during the reconnect. So we
                // compare first and leave the canvas (and its preserved frame) untouched when unchanged.
                // Preserve the established scale/resolution UNLESS the viewport actually changed. Resizing
                // re-derives a fresh scale (fine); keeping the frame means the framebuffer is already
                // scaled, so the client must NOT re-apply the scale on top of it (that doubled the UI).
                var resized = false;
                try {
                    var hidpiCb = document.getElementById("opt-hidpi");
                    var hiDpi = !!(hidpiCb && hidpiCb.checked);
                    var size = client.chooseDesktopSize(screenWrap, hiDpi);
                    if (size && (size.width !== canvas.width || size.height !== canvas.height)) {
                        client.applyDesktopSize(screenWrap, size);
                        resized = true;
                    }
                } catch (e) { /* keep the previous size if sizing throws */ }
                client.setPreserveScaleOnReconnect(!resized);
                client.connect(lastCreds);
            }

            function updateReconnectCountdown() {
                var remaining = Math.max(0, reconnectDeadline - performance.now());
                reconnectingSecs.textContent = Math.ceil(remaining / 1000);
                if (remaining <= 0) {
                    // Deadline reached: the connection is dead for real. Drop out of the reconnect state
                    // and fall back to the normal disconnected UI (login form or SSO reconnect popup).
                    stopReconnecting();
                    resetConsole("Reconnection timed out — the connection was lost.");
                }
            }

            // Enter (or refresh) the reconnect state after a drop. Keeps the last frame; starts the
            // countdown + retry loop the first time; a repeated "reconnecting" (failed attempt) just keeps
            // the existing loop running without resetting the deadline.
            function startReconnecting() {
                if (!lastCreds) { resetConsole("Connection lost."); return; } // nothing to retry with
                reconnectingOverlay.classList.add("show");
                if (reconnectActive) return; // already looping — a failed attempt re-fired "reconnecting"
                reconnectActive = true;
                reconnectDeadline = performance.now() + RECONNECT_DEADLINE_MS;
                updateReconnectCountdown();
                reconnectTickTimer = setInterval(updateReconnectCountdown, 1000);
                // First retry after RETRY_EVERY_MS (the drop just happened; give the network a moment),
                // then keep retrying on the same cadence. Each attempt's own failure won't stack timers.
                reconnectRetryTimer = setInterval(function () {
                    if (reconnectActive) attemptReconnect();
                }, RETRY_EVERY_MS);
            }

            btnRetryNow.addEventListener("click", function () {
                if (reconnectActive) attemptReconnect(); // immediate attempt; loop + deadline keep running
            });
            btnGiveUp.addEventListener("click", function () {
                stopReconnecting();
                client.disconnect();
                resetConsole("Reconnection cancelled.");
            });

            var qualityEl = document.getElementById("floatbar-quality");
            var qualityLabel = document.getElementById("floatbar-quality-label");
            var qualityBars = qualityEl.querySelectorAll(".quality-bars i");
            var QUALITY_LIT_BARS = { poor: 1, fair: 2, good: 4 }; // out of 4, ascending like phone signal
            client.setQualityCallback(function (q) {
                if (!q.level) { qualityEl.classList.remove("show"); return; }
                qualityEl.classList.remove("good", "fair", "poor");
                qualityEl.classList.add("show", q.level);
                var lit = QUALITY_LIT_BARS[q.level] || 0;
                qualityBars.forEach(function (bar, i) { bar.classList.toggle("lit", i < lit); });
                // q.rtt is the END-TO-END round trip (browser ↔ gateway ↔ desktop); the tooltip breaks
                // it down per leg so a slow reading is attributable (user's link vs. datacenter path).
                var rttText = (q.rtt != null) ? Math.round(q.rtt) + "ms" : "";
                var kbpsText = (q.kbps != null) ? (q.kbps >= 1024 ? (q.kbps / 1024).toFixed(1) + "Mbps" : Math.round(q.kbps) + "kbps") : "";
                qualityLabel.textContent = [rttText, kbpsText].filter(Boolean).join(" · ");
                var legs = [];
                if (q.browserRtt != null) legs.push("You ↔ gateway: " + Math.round(q.browserRtt) + " ms");
                legs.push("Gateway ↔ desktop: " + (q.hostRtt != null ? Math.round(q.hostRtt) + " ms" : "measuring…"));
                qualityEl.title = "Connection quality (end-to-end)\n" + legs.join("\n");
            });

            client.setStatusCallback(function (status, message) {
                switch (status) {
                    case "connecting":
                        break;
                    case "ready":
                        loginOverlay.style.display = "none";
                        reconnectOverlay.classList.remove("show");
                        stopReconnecting(); // a reconnect attempt succeeded: leave the countdown state
                        btnDisconnect.disabled = false;
                        showBar();          // reveal the floating bar on connect, then auto-hide
                        scheduleAutoHide();
                        showRecording();    // red frame + recording banner (no-op when not notifying)
                        break;
                    case "reconnecting":
                        // Network/protocol drop (not a graceful host disconnect). Keep the last frame on
                        // the canvas and run the countdown + auto-retry loop until it recovers or times out.
                        startReconnecting();
                        break;
                    case "error":
                        // A hard error (bad creds, host unreachable) — end any reconnect loop and fall
                        // back to the login/reconnect UI; retrying wouldn't heal this.
                        stopReconnecting();
                        // For SSO/auto-connect, resetConsole() shows the Reconnect popup (with the error
                        // as its message); for a manual session it re-shows the login form.
                        if (window.RDP_AUTOCONNECT) {
                            resetConsole(message || "Connection failed");
                        } else {
                            loginError.textContent = message || "Connection failed";
                            loginOverlay.classList.remove("hidden");
                            loginOverlay.style.display = "flex";
                            btnConnect.disabled = false;
                            btnConnect.textContent = "Connect";
                            btnDisconnect.disabled = true;
                            floatbar.classList.add("hidden");
                            hideRecording();
                        }
                        break;
                    case "closed":
                        // Session ended (user disconnect or server drop): reset the screen to black and
                        // offer a way to reconnect. `message`, when present, is the host's disconnect
                        // reason (logoff, admin disconnect, timeout) — show it so the user knows why.
                        resetConsole(message);
                        break;
                }
            });

            document.getElementById("login-form").addEventListener("submit", function (e) {
                e.preventDefault();
                loginError.textContent = "";
                var user = document.getElementById("vm-user").value;
                var pass = document.getElementById("vm-pass").value;
                var domain = document.getElementById("vm-domain").value;
                if (!user) { loginError.textContent = "Username is required."; return; }
                btnConnect.disabled = true;
                btnConnect.textContent = "Connecting…";

                // Build the RDP performanceFlags from the checkboxes. For a plain ENABLE_* flag,
                // checked = set the bit. For a DISABLE_* flag marked data-invert, the checkbox means
                // "keep this eye-candy" — so UNchecked sets the DISABLE bit.
                var perf = 0;
                var PERF = window.RDP_PERF || {};
                document.querySelectorAll(".perf-flag").forEach(function (cb) {
                    var bit = PERF[cb.getAttribute("data-perf")] || 0;
                    var invert = cb.getAttribute("data-invert") === "1";
                    if (invert ? !cb.checked : cb.checked) perf |= bit;
                });

                client.setAudioEnabled(true);
                client.setMuted(document.getElementById("opt-audio").checked);
                var muted = !(client.muted);
                client.setMuted(muted);
                if(muted) {
                    btnMute.classList.add("fa-red");
                } else {
                    btnMute.classList.remove("fa-red");
                }
                btnMute.innerHTML = muted ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume"></i>';

                client.setClipboardEnabled(document.getElementById("opt-clipboard").checked);

                // Microphone redirection must be decided BEFORE connect (the AUDIO_INPUT DVC is only
                // accepted if enabled at handshake time). The floatbar mic button then mutes/unmutes
                // capture at runtime. Reflect the initial state on the button.
                var micOn = document.getElementById("opt-microphone").checked;
                client.setMicrophoneEnabled(micOn);
                client.setMicMuted(!micOn);
                btnDisableMic.classList.toggle("fa-red", !micOn);
                btnDisableMic.innerHTML = micOn ? '<i class="fa-solid fa-microphone"></i>' : '<i class="fa-solid fa-microphone-slash"></i>';

                // Camera redirection — same pattern: decided before connect (the RDPECAM DVCs are only
                // accepted when enabled at handshake); the floatbar video button pauses/resumes at runtime.
                var camOn = document.getElementById("opt-camera").checked;
                client.setCameraEnabled(camOn);
                client.setCameraPaused(!camOn);
                btnDisableVideo.classList.toggle("fa-red", !camOn);
                btnDisableVideo.innerHTML = camOn ? '<i class="fa-solid fa-video"></i>' : '<i class="fa-solid fa-video-slash"></i>';

                // Create/resume the AudioContext now, inside this user gesture — browsers block audio
                // that starts without one, and the first wave arrives long after the click.
                if (client.audioEnabled) client.primeAudio();

                // GFX display mode (graphics pipeline + codec). Decided before connect: it controls the
                // CS_CORE GFX advertisement and the RDPGFX capsets. The dropdown is authoritative; the
                // ?gfx=<mode> URL param still works when the dropdown is left at its default ("off").
                var gfxSel = document.getElementById("opt-gfx-mode");
                var gfxMode = gfxSel ? gfxSel.value : "off";
                if (gfxMode === "off") {
                    var urlGfx = new URLSearchParams(window.location.search).get("gfx");
                    if (urlGfx) gfxMode = urlGfx; // honor the URL override only when UI is at default
                }
                window.RDP_GFX_MODE = gfxMode;

                // HiDPI: render at the panel's native device-pixel resolution (crisp on Retina) vs. the
                // logical CSS size (cheaper). Read from the popup checkbox.
                var hidpiCb = document.getElementById("opt-hidpi");
                var hiDpi = !!(hidpiCb && hidpiCb.checked);

                // Optionally persist credentials / settings to this user's authorization (best-effort,
                // fire-and-forget so it never blocks the connect). The server stores credentials
                // encrypted; settings become this resource's connect defaults for the user.
                var storeCreds = document.getElementById("opt-store-creds");
                var rememberSettings = document.getElementById("opt-remember-settings");
                if ((storeCreds && storeCreds.checked) || (rememberSettings && rememberSettings.checked)) {
                    var body = {
                        storeCredentials: !!(storeCreds && storeCreds.checked),
                        rememberSettings: !!(rememberSettings && rememberSettings.checked),
                        username: user, password: pass, domain: domain,
                        audio: document.getElementById("opt-audio").checked,
                        clipboard: document.getElementById("opt-clipboard").checked,
                        microphone: micOn, camera: camOn,
                        gfxMode: gfxMode, hiDpi: hiDpi, performanceFlags: perf
                    };
                    fetch("/connect/" + encodeURIComponent(window.RDP_RESOURCE_ID) + "/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(body)
                    }).catch(function () { /* non-fatal */ });
                }

                // Pick a desktop resolution that fills the visible area in *device* pixels (crisp on
                // HiDPI), bake it into the handshake by sizing the canvas before connecting.
                var size = client.chooseDesktopSize(screenWrap, hiDpi);
                client.applyDesktopSize(screenWrap, size);
                // Remember the creds so a network/protocol drop can silently replay connect() (see the
                // auto-reconnect controller). For an SSO/auto-connect session these come from the hidden
                // form pre-filled by the gateway; the gateway holds the real NLA creds either way.
                lastCreds = { user: user, password: pass, domain: domain, performanceFlags: perf };
                client.connect(lastCreds);
            });

            btnDisconnect.addEventListener("click", function () { client.disconnect(); });
            // Reconnect popup button (SSO sessions): re-submit the hidden login form, which still holds
            // the SSO field values + options, to re-establish the session.
            btnReconnect.addEventListener("click", function () {
                reconnectOverlay.classList.remove("show");
                reconnectMsg.textContent = "";
                var form = document.getElementById("login-form");
                if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event("submit", { cancelable: true }));
            });
            // Ctrl+Alt+Del is intercepted by the local OS before the page ever sees it, so the only way
            // to reach the remote Windows security screen (lock, change password, Task Manager) is to
            // synthesise the sequence. Drop focus afterwards so a following Space/Enter doesn't re-fire
            // the button instead of reaching the session.
            btnCad.addEventListener("click", function () {
                client.sendCtrlAltDel();
                btnCad.blur();
            });
            btnFullscreen.addEventListener("click", function () {
                if (!document.fullscreenElement) {
                    (screenWrap.requestFullscreen ? screenWrap.requestFullscreen() : Promise.reject()).catch(function () {});
                } else {
                    document.exitFullscreen();
                }
            });
            btnMute.addEventListener("click", function () {
                var muted = !(client.muted);
                client.setMuted(muted);
                if(muted) {
                    btnMute.classList.add("fa-red");
                } else {
                    btnMute.classList.remove("fa-red");
                }
                btnMute.innerHTML = muted ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume"></i>';
            });
            // Floatbar mic button: mute/unmute capture at runtime. (Whether the AUDIO_INPUT channel
            // exists at all is decided at connect from the "Microphone" option.) If the channel wasn't
            // enabled this session, the button just stays in the muted/slashed state.
            btnDisableMic.addEventListener("click", function () {
                if (!client.microphoneEnabled) return; // no mic channel this session
                var muted = !(client.micMuted);
                client.setMicMuted(muted);
                btnDisableMic.classList.toggle("fa-red", muted);
                btnDisableMic.innerHTML = muted ? '<i class="fa-solid fa-microphone-slash"></i>' : '<i class="fa-solid fa-microphone"></i>';
            });
            // Floatbar video button: pause/resume the camera feed at runtime (sends black frames while
            // paused). Whether the camera channel exists at all is decided at connect from the "Camera"
            // option; if it wasn't enabled this session the button stays in the slashed state.
            btnDisableVideo.addEventListener("click", function () {
                if (!client.cameraEnabled) return; // no camera channel this session
                var paused = !(client.cameraPaused);
                client.setCameraPaused(paused);
                btnDisableVideo.classList.toggle("fa-red", paused);
                btnDisableVideo.innerHTML = paused ? '<i class="fa-solid fa-video-slash"></i>' : '<i class="fa-solid fa-video"></i>';
            });
            // ---- clipboard overlay -------------------------------------------------------------------
            // Browser clipboard autosync is unfeasible (per-read gesture + permission), so clipboard
            // sync is manual: a popup textarea. The remote's copied text is pushed into the box, and the
            // box's contents are sent to the remote on "Send to remote".
            function setClipHint(msg, muted) {
                clipHint.textContent = msg || "";
                clipHint.classList.toggle("muted", !!muted);
            }
            function openClip() {
                if (clipOverlay.classList.contains("show")) return;
                clipOverlay.classList.add("show");
                setClipHint("");
                clipText.focus();
                clipText.select();
            }
            function closeClip() { clipOverlay.classList.remove("show"); }

            // Remote copied text → surface it in the textarea (the latest remote copy is the newest
            // event, so it replaces the box contents; a hint flags it when the popup is open).
            client.setRemoteClipboardCallback(function (text) {
                clipText.value = text == null ? "" : text;
                if (clipOverlay.classList.contains("show")) {
                    setClipHint("Received from remote", true);
                }
            });

            btnClip.addEventListener("click", function () {
                if (clipOverlay.classList.contains("show")) closeClip(); else openClip();
            });
            btnClipSend.addEventListener("click", function () {
                client.sendClipboardText(clipText.value);
                setClipHint("Sent to remote — paste in the session");
            });
            btnClipCopy.addEventListener("click", function () {
                clipText.focus();
                clipText.select();
                var ok = false;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(clipText.value).then(function () {
                        setClipHint("Copied to your clipboard", true);
                    }).catch(function () { setClipHint("Press Ctrl/Cmd+C to copy", true); });
                    return;
                }
                try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
                setClipHint(ok ? "Copied to your clipboard" : "Press Ctrl/Cmd+C to copy", true);
            });
            btnClipClose.addEventListener("click", closeClip);
            // Click the dimmed backdrop (outside the card) to dismiss.
            clipOverlay.addEventListener("mousedown", function (e) { if (e.target === clipOverlay) closeClip(); });
            // Esc closes; Ctrl/Cmd+Enter sends.
            clipText.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { e.preventDefault(); closeClip(); }
                else if ((e.ctrlKey || e.metaKey) && e.key === "Enter") { e.preventDefault(); btnClipSend.click(); }
            });

            // ---- floating bar: auto-hide + click-to-minimize ------------------------------------
            // The bar reveals on mouse activity near the top, stays while hovered, and auto-hides a
            // couple of seconds after you stop interacting with it. The grip toggles a minimized
            // (name + status only) state that persists across reveals.
            var hideTimer = null;
            // Only reveal the bar while a session is live — when disconnected / not yet connected there
            // is nothing to control, so the bar stays hidden.
            function showBar() { if (client.connected) floatbar.classList.remove("hidden"); }
            function scheduleAutoHide() {
                if (hideTimer) clearTimeout(hideTimer);
                hideTimer = setTimeout(function () {
                    if (!client.connected) { floatbar.classList.add("hidden"); return; } // never linger while disconnected
                    if (floatbar.matches(":hover")) { scheduleAutoHide(); return; }
                    floatbar.classList.add("hidden");
                }, 2200);
            }
            floatbar.addEventListener("mouseenter", function () { if (hideTimer) clearTimeout(hideTimer); });
            floatbar.addEventListener("mouseleave", scheduleAutoHide);
            // Reveal when the pointer reaches the top edge of the screen (only while connected).
            revealZone.addEventListener("mouseenter", function () { if (!client.connected) return; showBar(); scheduleAutoHide(); });
            // Live remote resolution changes (MS-RDPEDISP). On a *genuine, settled* viewport change we
            // ask the server for a new resolution that fills the area. Guards against the spurious
            // resize/reflow events that fire right after connect (which must NOT trigger a layout —
            // doing so mid-stream changes the server's resolution and stalls output):
            //   - only after the session has been active for a moment,
            //   - debounced long enough to ignore transient settles,
            //   - only when the requested size differs meaningfully from what we last applied.
            var resizeTimer = null;
            function onViewportChange() {
                if (!client.connected) return;
                client._fit(screenWrap);                 // keep the current canvas fitted (cheap, no RDP)
                if (resizeTimer) clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    resizeTimer = null;
                    client.maybeResize(screenWrap);
                }, 600);
            }
            window.addEventListener("resize", onViewportChange);
            document.addEventListener("fullscreenchange", onViewportChange);

            window.addEventListener("beforeunload", function () { client.disconnect(); });

            // ---- session start (after preflight) ----------------------------------------------------
            // Called once the preflight readiness flow reports the resource is up. For an SSO session it
            // primes the perf checkboxes from the stored mask and auto-submits the (hidden) login form;
            // for a manual session it reveals the login form so the user can enter credentials.
            function startSession() {
                if (window.RDP_AUTOCONNECT) {
                    // Reflect the stored PerformanceFlags onto the perf checkboxes (so the existing submit
                    // handler reassembles the same mask), then submit the form programmatically. The submit
                    // handler reads all fields/checkboxes exactly as for a manual login; the only difference
                    // is client.js suppresses the credentials WS frame (window.RDP_AUTOCONNECT), since the
                    // gateway already holds the credentials for NLA.
                    var PERF = window.RDP_PERF || {};
                    var mask = window.RDP_DEFAULT_PERF | 0;
                    document.querySelectorAll(".perf-flag").forEach(function (cb) {
                        var bit = PERF[cb.getAttribute("data-perf")] || 0;
                        var set = bit ? (mask & bit) !== 0 : false;
                        var invert = cb.getAttribute("data-invert") === "1";
                        // checked = "keep eye-candy": for an inverted (DISABLE_*) flag, checked means the
                        // bit is NOT set; for a plain ENABLE_* flag, checked means the bit IS set.
                        cb.checked = invert ? !set : set;
                    });
                    var form = document.getElementById("login-form");
                    if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event("submit", { cancelable: true }));
                } else {
                    // Manual session: show the login form now that the resource is ready.
                    loginOverlay.classList.remove("hidden");
                    loginOverlay.style.display = "flex";
                }
            }

            // ---- preflight: resource readiness ------------------------------------------------------
            // Before the login form / auto-connect, run the readiness flow (start/resume the VM, wait for
            // the guest agent, IP and RDP probe) via /connect/{id}/begin + /status. This runs even on a
            // direct link to the console, so the start process always happens. On success, startSession()
            // takes over; on failure, an error + "Try again" is shown in the preflight card.
            var pfBar = document.getElementById("pf-progress-bar");
            var pfMessage = document.getElementById("pf-message");
            var pfStepLabel = document.getElementById("pf-step-label");
            var pfStepCounter = document.getElementById("pf-step-counter");
            var pfError = document.getElementById("pf-error");
            var pfErrorText = document.getElementById("pf-error-text");
            var pfActions = document.getElementById("pf-actions");
            var pfRetry = document.getElementById("pf-retry");
            var pfIcon = document.getElementById("pf-icon");
            var pfId = window.RDP_RESOURCE_ID;
            var pfLabels = {
                checking: "Checking resource…",
                provisioning: "Creating your desktop… (first connect, this can take a few minutes)",
                starting: "Starting resource…",
                guestagent: "Waiting for guest agent…",
                waitingip: "Waiting for IP address…",
                rdpprobe: "Waiting for remote desktop…",
                finalizing: "Finalizing connection…",
                ready: "Ready"
            };
            // Mirrors ReadinessPhase in RDP/ConnectionReadiness.cs (lower-cased). "provisioning" only occurs on
            // the first connect to a VDI pool (the clone); without it here the bar sat on step 1 for minutes.
            var pfOrder = ["checking", "provisioning", "starting", "guestagent", "waitingip", "rdpprobe", "finalizing", "ready"];
            var pfStepCount = pfOrder.length - 1; // 'ready' is completion, not a step

            function pfRender(phase) {
                var idx = pfOrder.indexOf(phase);
                if (idx < 0) return;
                pfBar.style.width = Math.round((idx / pfStepCount) * 100) + "%";
                pfBar.classList.toggle("done", idx === pfOrder.length - 1);
                if (idx === pfOrder.length - 1) {
                    pfStepLabel.textContent = pfLabels.ready;
                    pfStepCounter.textContent = "";
                } else {
                    pfStepLabel.textContent = pfLabels[phase] || phase;
                    pfStepCounter.textContent = "Step " + (idx + 1) + " of " + pfStepCount;
                }
            }

            function pfFail(message) {
                pfErrorText.textContent = message || "The connection could not be prepared.";
                pfError.classList.remove("hidden");
                pfActions.classList.remove("hidden");
                pfBar.className = "h-full rounded-full bg-destructive transition-all duration-500 ease-out";
                pfIcon.classList.add("failed"); // stop the pulse, tint the icon red
            }

            // Apply a status DTO; returns true when the flow is terminal (ready or failed).
            function pfApply(dto) {
                if (!dto) return false;
                if (dto.message) pfMessage.textContent = dto.message;
                if (dto.failed) { pfFail(dto.error || dto.message); return true; }
                pfRender(dto.phase);
                if (dto.done) {
                    pfMessage.textContent = "Connecting…";
                    preflightOverlay.classList.add("hidden");
                    startSession();
                    return true;
                }
                return false;
            }

            function pfPoll() {
                fetch("/connect/" + encodeURIComponent(pfId) + "/status", { headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.json(); })
                    .then(function (dto) { if (!pfApply(dto)) setTimeout(pfPoll, 1000); })
                    .catch(function () { setTimeout(pfPoll, 2000); });
            }

            function pfBegin() {
                pfError.classList.add("hidden");
                pfActions.classList.add("hidden");
                pfIcon.classList.remove("failed"); // resume the pulsing animation
                pfBar.className = "h-full rounded-full transition-all duration-500 ease-out";
                pfRender("checking");
                fetch("/connect/" + encodeURIComponent(pfId) + "/begin", { method: "POST", headers: { "Accept": "application/json" } })
                    .then(function (r) { return r.json(); })
                    .then(function (dto) { if (!pfApply(dto)) pfPoll(); })
                    .catch(function () { pfFail("Could not reach the gateway."); });
            }

            pfRetry.addEventListener("click", function (e) { e.preventDefault(); pfBegin(); });
            pfBegin();
        })();
    </script>
</body>
</html>
