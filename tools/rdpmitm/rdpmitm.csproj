<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Link the gateway's RDP auth classes directly instead of project-referencing the Web SDK app. -->
    <RootNamespace>KSol.RDPGateway.RDP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../RDP/CredSspClient.cs" />
    <Compile Include="../../RDP/NtlmClient.cs" />
    <Compile Include="../../RDP/Ntlm.cs" />
    <Compile Include="../../RDP/AuthCrypto.cs" />
    <Compile Include="../../RDP/KerberosAuth.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kerberos.NET" Version="4.6.146" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
