<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared RDP wire decode/encode/dump engine. Consumed by the gateway (KSol.RDPGateway, for live
       session decode + recording) and the standalone MITM proxy (tools/rdpmitm). Auth-independent:
       only System.* dependencies. Namespace KSol.RDPGateway.RDP matches the gateway's RDP namespace
       so existing gateway code can use these types without aliasing. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KSol.RDPGateway.RDP</RootNamespace>
    <AssemblyName>KSol.RDP.Wire</AssemblyName>
  </PropertyGroup>

</Project>
