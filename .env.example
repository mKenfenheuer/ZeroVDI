# Copy to .env and fill in. docker compose reads it automatically.
# Never commit the real .env — it holds the key that protects every stored credential.

# ---- Required -----------------------------------------------------------------------------------

# Encrypts the credential keyring at rest (stored VM / IPMI / SSH secrets and, if enabled, the
# session recordings). The app refuses to start in Production without it.
#   openssl rand -base64 48
# BACK THIS UP. Losing it makes every stored credential and encrypted recording unrecoverable.
DataProtection__MasterKeyPassphrase=

# The address your users type. Password-reset and e-mail-change links, and the OpenID Connect
# redirect URI, are built from this instead of the incoming Host header.
App__PublicBaseUrl=https://vdi.example.com

# ---- Recommended --------------------------------------------------------------------------------

# Reject requests carrying any other Host header. Comma-separated; '*' accepts anything.
AllowedHosts=vdi.example.com

# The first administrator. Leave the password empty to have a strong one generated and logged once
# at first start (grab it from `docker compose logs`).
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=

# Your reverse proxy's address, so X-Forwarded-* headers are honoured only from it and the audit log
# records real client IPs. Comma-separated list of IPs.
ForwardedHeaders__KnownProxies=

# The host port the console is published on (ignored when using host networking).
ZEROVDI_PORT=8080

# ---- Optional: connector agent (docker compose --profile connector up -d) -------------------------

ZEROVDI_URL=https://vdi.example.com
ZEROVDI_REGISTRATION_TOKEN=
ZEROVDI_AUTH_TOKEN=

# ---- Optional: pin image versions instead of :latest ----------------------------------------------

# :latest and :main follow the main branch; a tagged release (v1.2.3) also publishes :1.2.3 and :1.2.
# APP_IMAGE=ghcr.io/mkenfenheuer/zerovdi:0.6.46
# CONNECTOR_IMAGE=ghcr.io/mkenfenheuer/zerovdi/connector:0.6.46
