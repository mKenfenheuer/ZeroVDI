<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local feed for the RDPGW library while it is co-developed in the sibling rdpgw.net repo.
      The packed RDPGW.<version>.nupkg is dropped into ./local-nuget. Remove this source (and the
      pinned local version) once the corresponding RDPGW version is published to nuget.org.
    -->
    <add key="local" value="local-nuget" />
  </packageSources>
</configuration>
